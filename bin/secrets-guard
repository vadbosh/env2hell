#!/usr/bin/env bash
# secrets-guard.sh — PreToolUse Bash hook for Claude Code (and Codex).
# Blocks commands that would dump secrets (API keys / tokens) into the session
# transcript: bare env/printenv/export -p/set/declare/history, and reads of
# dotfiles / .env / private keys / /proc/*/environ.
#
# exit 2 + stderr => call denied, stderr shown to the model as feedback.
#
# Two passes, deliberately:
#   A) dump commands  — scanned on QUOTE-STRIPPED text, so words appearing
#      inside a quoted jq/awk/sed program or a regex alternation are not
#      mistaken for real commands (that false positive blocked legitimate
#      config edits before this split existed).
#   B) secret-file reads — scanned on the RAW text, because the path we care
#      about is often quoted and would be erased by pass A's stripping.
set -fuo pipefail

input="$(cat)"
cmd="$(printf '%s' "$input" | jq -r '.tool_input.command // empty' 2>/dev/null)"
[ -n "$cmd" ] || exit 0   # jq missing / no command => fail open, never break the CLI

block () { printf '%s\n' "$1" >&2; exit 2; }

# A heredoc body is data being written to a file, not a list of commands. Both
# passes below used to read it as commands, so writing a file whose text
# mentions `env` or `cat .env` was denied — which is how this repository came to
# document a workaround for its own guard. The bodies come out here, once,
# because pass A is shell and has no way to know about them.
#
# `<<<` is a here-string, not a heredoc: after the second `<` comes a third,
# which is neither `-`, a space, a quote nor a letter, so it cannot match. The
# `cat > file` in front of the heredoc is still a command and still scanned.
# shellcheck disable=SC2016
cmd="$(printf '%s\n' "$cmd" | awk '
heredoc != "" {
  line = $0
  sub(/^[[:space:]]+/, "", line)
  sub(/[[:space:]]+$/, "", line)
  if (line == heredoc) heredoc = ""
  next
}
{
  if (match($0, /<<-?[[:space:]]*["\047]?[A-Za-z_][A-Za-z0-9_]*/)) {
    d = substr($0, RSTART, RLENGTH)
    sub(/^<<-?[[:space:]]*/, "", d)
    gsub(/["\047]/, "", d)
    heredoc = d
  }
  print
}')"
[ -n "$cmd" ] || exit 0

# ---------- too large to check ----------
# Failing open is the right answer to an unexpected payload — that contract is
# in docs/design.md and it stays. A command too big to finish is not an
# unexpected payload: it is the guard not doing its job. Killed at the hook
# runner's timeout, a PreToolUse hook does not deny; the command goes through
# unchecked and nothing anywhere says so.
#
# The limit is a count, not a clock. A clock needs `timeout`, which macOS does
# not ship, and it would have to bound the whole script rather than one pass —
# measured 2026-09-17, 100 000 sub-commands cost 16.5 s in total and only 12 of
# those are the awk program. A count costs one cheap pass and gives the same
# answer on every machine.
#
# Measured on this machine, total: 20 000 → 3.6 s, 50 000 → 8.4 s,
# 100 000 → 16.5 s, against GUARD_TIMEOUT = 30 in lib/patch_config.py. Fifty
# thousand leaves room for a box three times slower. A command that large is a
# heredoc of about a megabyte, so this denial is rare — and a rare denial with
# a message beats a silent pass.
GUARD_MAX_SUBS=50000
subcount="$(printf '%s\n' "$cmd" | awk '{ n += 1 + gsub(/[;&|]/, "") } END { print n+0 }')"
if [ "${subcount:-0}" -gt "$GUARD_MAX_SUBS" ]; then
  block "[secrets-guard] Blocked: $subcount sub-commands is more than this guard can check ($GUARD_MAX_SUBS), so the command was never checked. Split it, or write the file with an editor instead of a heredoc."
fi

# The backticks are literal text for the reader, not command substitution.
# shellcheck disable=SC2016
ENV_MSG='[secrets-guard] Blocked: bare env/printenv/export/set/declare leaks secrets to the session. Use `safe-env` (values masked), or `echo "$VAR"` for one value.'

# ---------- pass A: dump commands, on quote-stripped text ----------
scan="$(printf '%s' "$cmd" | sed -E "s/'[^']*'/Q/g; s/\"[^\"]*\"/Q/g")"
subs="$(printf '%s\n' "$scan" | sed -E 's/(\|\||&&|;|&|\|)/\n/g')"

while IFS= read -r sub; do
  sub="${sub#"${sub%%[![:space:]]*}"}"          # trim leading whitespace
  [ -z "$sub" ] && continue
  # Word splitting is the point here — the sub-command has to become tokens.
  # `set -f` at the top disables globbing, which is the risk SC2206 warns about.
  # shellcheck disable=SC2206
  toks=($sub)
  i=0
  while [ $i -lt ${#toks[@]} ]; do              # skip wrappers
    case "${toks[$i]}" in
      sudo|rtk|time|command|exec|xargs|nice|nohup) i=$((i+1));;
      *) break;;
    esac
  done
  # A leading assignment sets a variable for the command that follows; it is not
  # the command. Skipping only the token would have been right, and instead the
  # `=` failed the charset test below and the WHOLE sub-command was abandoned —
  # so `FOO=bar env` dumped the environment.
  while [ $i -lt ${#toks[@]} ]; do
    case "${toks[$i]}" in
      [a-zA-Z_]*=*) i=$((i+1));;
      *) break;;
    esac
  done
  [ $i -ge ${#toks[@]} ] && continue
  first="${toks[$i]}"
  # `\env` is the ordinary way to bypass an alias, and `/usr/bin/env` is the
  # ordinary way to bypass PATH. Neither is an evasion and both dumped the
  # environment. The basename is what names the program — the same reading
  # lib/patch_config.py uses to decide whose hook entry is whose.
  first="${first#\\}"
  first="${first##*/}"
  first="${first##*\\}"
  # only a plain word can be a command name; skip "…", =…, {…, […, $…, *… fragments
  case "$first" in
    [a-zA-Z_]*) ;;
    *) continue;;
  esac
  case "$first" in *[!a-zA-Z0-9_.-]*) continue;; esac
  rest=("${toks[@]:$((i+1))}")

  case "$first" in
    env)
      has_cmd=0
      for t in "${rest[@]}"; do
        case "$t" in -*) ;; *=*) ;; *) has_cmd=1;; esac
      done
      [ "$has_cmd" = "1" ] || block "$ENV_MSG"   # `env VAR=v cmd` is fine; bare dump is not
      ;;
    printenv)
      # `-0` and `--null` change the separator, not the scope: with no VARIABLE
      # named, printenv still prints every pair. Naming one is the behaviour to
      # encourage, so the test is "is there an argument that is not a flag".
      has_name=0
      for t in "${rest[@]}"; do case "$t" in -*) ;; *) has_name=1;; esac; done
      [ "$has_name" = "1" ] || block "$ENV_MSG"
      ;;
    export)    { [ ${#rest[@]} -eq 0 ] || [ "${rest[0]}" = "-p" ] || [ "${rest[0]}" = "-px" ]; } && block "$ENV_MSG" ;;
    set)       [ ${#rest[@]} -eq 0 ] && block "$ENV_MSG" ;;
    history)   block "$ENV_MSG" ;;
    declare|typeset)
      has_assign=0
      for t in "${rest[@]}"; do case "$t" in *=*) has_assign=1;; esac; done
      [ "$has_assign" = "1" ] || block "$ENV_MSG"
      ;;
  esac
done <<< "$subs"

# ---------- pass B: secret-file reads ----------
# The reader has to be a real command, so it is looked for in the QUOTE-STRIPPED
# text; the path may legitimately be quoted, so it is looked for in the RAW one.
# Splitting it this way is what keeps prose out of the decision: a commit message
# containing the words `cat .env` is an argument, not a command, and stripping
# quotes removes it before the reader is ever found.
READERS='(^|[[:space:];|&(])(cat|bat|batcat|tac|nl|head|tail|less|more|view|od|xxd|strings|type|gc)([[:space:]]|$)'

# The list above is every pager and dumper — and for a year it was the whole
# list, which left out the tools an assistant actually reaches for when it wants
# PART of a file. `grep . ~/.aws/credentials` printed the file and was allowed;
# so were `sed -n 1,5p`, `awk '{print}'`, `sort`, `uniq`, `cut` and `rev`. The
# standing rules on this machine tell the assistant to prefer `rg`/`grep` for
# reading file content, so the one path that was open was also the recommended
# one.
#
# They are a separate variable because one of them is not always a read:
# `sed -i` and `awk -i inplace` EDIT the file and print nothing, and denying an
# edit of a dotfile is the kind of refusal that gets a guard uninstalled.
EXTRACTORS='(^|[[:space:];|&(])(grep|egrep|fgrep|rg|ag|ack|sed|awk|gawk|mawk|sort|uniq|cut|rev|column|jq|yq)([[:space:]]|$)'
# `-i`, `-i.bak`, `--in-place`, and awk's `-i inplace`: the command writes the
# file rather than printing it.
INPLACE='(^|[[:space:]])(-i([^[:space:]]*)?|--in-place([^[:space:]]*)?|inplace)([[:space:]]|$)'

# Path separator: forward slash on Unix, backslash on Windows. Every store below
# accepts either, because a Git Bash or WSL shell is routinely handed a path in
# the other spelling.
S='[/\\]'
# `.env`, and the shell startup files. Windows spells netrc `_netrc`, so the
# leading character is either a dot or an underscore.
SECRET_PATHS='(^|[[:space:]"'"'"'/=])\.env([.[:space:]"'"'"']|$)'
# A file NAMED `<something>.env` — `prod.env`, `config/production.env` — is the
# other half of the same store, and until 0.7.0 only the bare `.env` was denied
# while the list in docs/patterns.md said `*.env`. The component before `.env`
# may not itself contain a dot: that is what keeps
# `jq -r '.permission.bash.env' opencode.json | head` working, where `.env` is
# the tail of a config key and the character before `bash` is a dot.
SECRET_PATHS="$SECRET_PATHS"'|(^|[[:space:]"'"'"'/=])[A-Za-z0-9_-]+\.env([.[:space:]"'"'"']|$)'
SECRET_PATHS="$SECRET_PATHS|${S}[._](bashrc|zshrc|profile|bash_profile|zshenv|zprofile|netrc)"
# Private keys and certificates.
SECRET_PATHS="$SECRET_PATHS|id_rsa|id_ed25519|id_ecdsa"
SECRET_PATHS="$SECRET_PATHS"'|\.(pem|p12|pfx|key)([[:space:]"'"'"']|$)'
# Credential stores of the tools a developer actually has installed. These live
# in the same place on Windows, under a backslash path.
SECRET_PATHS="$SECRET_PATHS|\\.aws${S}credentials|\\.docker${S}config\\.json|\\.kube${S}config|\\.azure$S"
SECRET_PATHS="$SECRET_PATHS"'|\.git-credentials|\.npmrc|\.pypirc|\.pgpass|\.my\.cnf'
# Where a Windows user writes `$env:API_KEY = "..."` — the counterpart of
# `.bashrc`, and just as worth not printing.
SECRET_PATHS="$SECRET_PATHS"'|Microsoft\.PowerShell_profile\.ps1'
# The credential stores of the tools a developer has open on the same day. Each
# of these held a live token and printed it on request until 2026-09-17;
# `~/.config/gh/hosts.yml` is the sharpest, because the standing rules tell the
# assistant to reach for `gh` in place of a disabled MCP server.
SECRET_PATHS="$SECRET_PATHS|${S}gh${S}hosts\\.yml"
SECRET_PATHS="$SECRET_PATHS|\\.terraformrc|terraform\\.rc|credentials\\.tfrc\\.json"
SECRET_PATHS="$SECRET_PATHS|${S}gcloud${S}(credentials\\.db|access_tokens\\.db"
SECRET_PATHS="$SECRET_PATHS|application_default_credentials\\.json)"
SECRET_PATHS="$SECRET_PATHS|\\.cargo${S}credentials|\\.gem${S}credentials"
SECRET_PATHS="$SECRET_PATHS|\\.m2${S}settings(-security)?\\.xml"
SECRET_PATHS="$SECRET_PATHS|rclone\\.conf|\\.vault-token|\\.databrickscfg"
SECRET_PATHS="$SECRET_PATHS|\\.snowflake${S}config|${S}containers${S}auth\\.json"
SECRET_PATHS="$SECRET_PATHS|${S}helm${S}registry${S}config\\.json"
# `~/.ssh/config` is deliberately NOT here. It holds hostnames and IdentityFile
# paths, not keys, and denying it would break ordinary work for no gain. Pinned
# as an `allow` in tests/test_policy.sh so nobody adds it by tidiness.
# Linux-only by construction: no such thing on Windows or macOS. `self` and
# `thread-self` are not digits, and `cat /proc/self/environ` is the shortest way
# there is to print this process's own environment.
SECRET_PATHS="$SECRET_PATHS|/proc/([0-9]+|self|thread-self)/environ"
SECRET_PATHS="($SECRET_PATHS)"

# The reader and the path have to be in the SAME sub-command. Looking for them
# anywhere in the whole line denied things that read nothing:
#
#   rsync -e "ssh -i ~/.ssh/id.pem" host:/src /dst | head -5
#
# `.pem` there is the identity ssh authenticates with, and `head` reads rsync's
# output — two different commands, neither reading a key. Requiring locality
# keeps every real case (`cat .env`, `cat .env | grep X`, `ls && cat .env` all
# have both halves in one sub-command) and drops that class of false positive.
#
# The split has to happen on the RAW text, because the path is what is being
# looked for and pass A's stripping would erase a quoted one. Separators inside
# quotes are not separators, so a quoted jq program holding `;` or `|` stays in
# one piece — hence the quote-aware pass rather than another sed.
#
# The split, the file check and the credential-name check are one awk program,
# further down. They used to be the split plus two shell loops, and each loop
# forked sed and grep once per sub-command: about 13 ms apiece. A heredoc
# contributes one sub-command per line of its body, so writing a 550-line file
# took longer than the hook's own timeout — and a PreToolUse hook killed at its
# timeout does not deny, it lets the command through with nothing said. The cost
# was never a cost; it was the guard failing open. Measured 2026-09-17: 500
# lines 6.9 s, 1000 lines 13.3 s, 2000 lines 26.6 s.

# `.env.example` and its siblings are the opposite of a secret store: they are
# committed precisely because they hold no values, and reading one is the first
# thing anybody does in an unfamiliar repository. The `.env` pattern above ends
# in `[.[:space:]"']`, which is what makes `.env.production` match — and matched
# these with it. There is no negative lookahead in ERE, so the template names
# are renamed out of the text before the path is looked for. `.env.production`
# is untouched and still denied; `cat .env.example .env` still trips on the
# second argument, which is the point. The replacement contains no `env` at all,
# so it cannot match in any spelling — the port matches case-insensitively.
ENV_TEMPLATES='\.env\.(example|sample|template|dist|defaults)'

# ── printing a credential-named variable ───────────────────────────────────
# ENV_MSG above offers `echo "$VAR"` as the safe way to read one value, and for
# PATH or EDITOR it is. For a variable whose NAME says "credential" it is the
# last hand-operated way to put a key into the transcript: the value comes out
# bare, alone on its line, with no label beside it. secrets-redact's tier 2 has
# nothing to key on there, and tier 1 cannot recognise a provider-less token —
# a Huawei access key is 20 characters of uppercase and digits, its secret 40 of
# base62, shapes indistinguishable from a git SHA or a build identifier. Shape
# cannot decide it; the name can, and the name is visible here.
#
# `safe-env | grep NAME` answers the question this command was asked for — is
# the variable set — without printing the value.
CRED_NAME='(PASSWD|PASSWORD|PASSPHRASE|TOKEN|SECRET|API_?KEY|APIKEY'
CRED_NAME="$CRED_NAME"'|AUTH_?TOKEN|ACCESS_?KEY|SECRET_?KEY|CLIENT_?SECRET'
CRED_NAME="$CRED_NAME"'|PRIVATE_?KEY|CREDENTIAL)'

# The name above has to be a WHOLE component of the variable name, not a
# substring of one. Matched as a substring it denied `$passed`, `$bypass_cache`,
# `$compass_dir` and `$PASSENGER_ROOT` — and `printf 'passed %d, failed %d\n'
# "$pass" "$fail"`, which is this project's own test harness reporting its
# results. A guard that denies ordinary shell gets switched off, and then it
# guards nothing.
#
# So: underscore-separated components on the left, the same on the right, and a
# non-name character or end of line after them. `$HW_SECRET_KEY`, `$db_password`
# and `${GITHUB_TOKEN:0:20}` still match; `$passed` cannot, because `ed` is
# neither a component nor a boundary.
#
# `PASS` is the one name that needs a neighbour. `DB_PASS` and `MYSQL_PASS` are
# how a password is spelled in half the compose files in existence, so the word
# has to stay — but on its own, `$pass` is a test counter at least as often as
# it is a credential, and `printf 'passed %d, failed %d\n' "$pass" "$fail"` is
# the shape it actually turns up in. So it counts only with another component
# beside it: `DB_PASS` and `PASS_FILE` are denied, a lone `$pass` is not.
# `PASSWORD`, `PASSWD` and `PASSPHRASE` say it on their own and stay above.
CRED_BOUND="([^A-Za-z0-9_]|\$)"
CRED_VAR="\\\$\\{?([A-Za-z0-9]+_)*$CRED_NAME(_[A-Za-z0-9]+)*$CRED_BOUND"
CRED_VAR="$CRED_VAR|\\\$\\{?(([A-Za-z0-9]+_)+PASS(_[A-Za-z0-9]+)*"
CRED_VAR="$CRED_VAR|PASS(_[A-Za-z0-9]+)+)$CRED_BOUND"

# ── passes B and C, in one program ──────────────────────────────────────────
# The patterns arrive through the environment rather than through `-v`, because
# -v processes escape sequences and every one of these is a regular expression
# full of backslashes. ENVIRON is POSIX; mawk and gawk both have it.
#
# Case: `grep -Eqi` was case-insensitive for the credential name and case
# SENSITIVE for everything else. awk has no per-match flag, so the credential
# test runs against toupper() of the text and the rest does not.
#
# Single-quoted spans are removed before the credential match. Inside them bash
# performs no expansion at all, so `$SECRET` there is seven literal characters,
# and writing a template that contains one is ordinary work:
#
#     printf 'key: ${secret_name}\n' > deploy.yaml
#
# Double quotes are deliberately left in place: `echo "$HW_SECRET_KEY"` does
# expand, and that is the case the rule exists for.
#
# A command substitution is a different command, and its arguments are not this
# one's output. `echo "$(curl -u "$E:$API_TOKEN" ...)"` prints what curl
# returned, not the token — blocking it taught nothing and cost a rewrite of a
# working command. Each body is checked on its own and then collapsed, which
# keeps `echo "$(printf '%s' "$TOKEN")"` caught.
verdict="$(printf '%s\n' "$cmd" \
  | GUARD_READERS="$READERS" GUARD_PATHS="$SECRET_PATHS" \
    GUARD_EXTRACTORS="$EXTRACTORS" GUARD_INPLACE="$INPLACE" \
    GUARD_CRED="$CRED_VAR"   GUARD_TPL="$ENV_TEMPLATES" \
    awk '
function strip_sq(s,   sq) {
  sq = "\047"
  gsub(sq "[^" sq "]*" sq, "Q", s)
  return s
}
function drop_first_quoted(s,   i, c, out, inq, pre, ntok, tok, only_flags, dropped) {
  # Drop the first quoted span, but only when it sits where the SEARCH PATTERN
  # sits: right after the command name and its flags. `grep -rn "cat .env" docs/`
  # searches for the words and reads nothing, so that span must not be treated
  # as a path. `grep KEY "$HOME/.env"` has an unquoted pattern and a quoted
  # path — there the span is a path and stays.
  out = ""; inq = ""; dropped = 0
  for (i = 1; i <= length(s); i++) {
    c = substr(s, i, 1)
    if (inq == "") {
      if ((c == "\"" || c == "\047") && !dropped) {
        pre = substr(s, 1, i - 1)
        only_flags = 1; ntok = split(pre, tok, /[[:space:]]+/)
        for (j = 2; j <= ntok; j++)
          if (tok[j] != "" && substr(tok[j], 1, 1) != "-") only_flags = 0
        if (only_flags) { inq = c; dropped = 1; continue }
      }
      out = out c
    } else if (c == inq) inq = ""
  }
  return out
}
function strip_quotes(s) {
  s = strip_sq(s)
  gsub(/"[^"]*"/, "Q", s)
  return s
}
BEGIN {
  READERS = ENVIRON["GUARD_READERS"]
  EXTRACTORS = ENVIRON["GUARD_EXTRACTORS"]
  INPLACE = ENVIRON["GUARD_INPLACE"]
  PATHS   = ENVIRON["GUARD_PATHS"]
  CRED    = ENVIRON["GUARD_CRED"]
  TPL     = ENVIRON["GUARD_TPL"]
  PRINTER = "(^|[[:space:]])(echo|printf)([[:space:]]|$)"

  # pass D — a dump command reached through something that runs a command for
  # you. `bash -c env`, `eval env` and `python3 -c "print(os.environ)"` are not
  # evasions; they are shapes an assistant writes by habit, and pass A cannot
  # see inside them because it works on quote-stripped text.
  #
  # The payload has to BE the dump command, not merely contain the word: that
  # is what keeps `sh -c "set -e; make"` and `bash -c "echo env"` working. For
  # the interpreters the test is the idiom instead, because the payload is not
  # shell and parsing it is not on the table. Both lists are partial by
  # construction — docs/design.md says so under "what this does not do".
  DUMPWORD = "(env|printenv|set|declare|typeset|history)"
  PAYLOAD  = "(-c|-e|eval)[[:space:]]*[\"\047]?[[:space:]]*" DUMPWORD "[[:space:]]*[\"\047]?[[:space:]]*$"
  IDIOM    = "(os\\.environ|process\\.env|%ENV|ENV\\.to_h|ENV\\.to_hash|ENV\\.each)"
  # A command substitution runs its body as a command, and pass A never sees it.
  SUBST    = "\\$\\([[:space:]]*" DUMPWORD "[[:space:]]*(\\)|\\|)"
}
verdict != "" { next }
{
  n = 0; buf = ""; q = ""
  for (i = 1; i <= length($0); i++) {
    c = substr($0, i, 1)
    if (q == "") {
      if (c == "\"" || c == "\047") { q = c; buf = buf c; continue }
      if (c == ";" || c == "&" || c == "|") { subs[++n] = buf; buf = ""; continue }
      buf = buf c
    } else {
      if (c == q) q = ""
      buf = buf c
    }
  }
  subs[++n] = buf

  for (i = 1; i <= n; i++) {
    s = subs[i]
    if (s ~ /^[[:space:]]*$/) continue

    # pass B — the reader has to be a command, so it is looked for in the
    # quote-stripped text; the path may legitimately be quoted, so it is looked
    # for in the raw one, with the template names renamed out first.
    reads = 0; pathtext = s
    if (strip_quotes(s) ~ READERS) reads = 1
    if (strip_quotes(s) ~ EXTRACTORS && s !~ INPLACE) {
      reads = 1
      # For grep and its relatives the FIRST quoted argument is the pattern
      # being searched for, not a path — `grep -rn "cat .env" docs/` searches
      # for the words and reads nothing. Drop that one span before looking for
      # a store; a quoted path later on the line still counts, which is what
      # keeps `grep KEY "$HOME/.env"` denied.
      pathtext = drop_first_quoted(s)
    }
    if (reads) {
      p = pathtext
      gsub(TPL, ".TPLFILE", p)
      if (p ~ PATHS) { verdict = "FILE"; next }
    }

    # pass D — a dump command inside something that runs commands
    if (s ~ PAYLOAD || s ~ SUBST) { verdict = "DUMP"; next }
    if (s ~ IDIOM)                { verdict = "DUMP"; next }

    # pass C — printing a credential-named variable.
    # A here-string prints its text too: `cat <<< "$GITHUB_TOKEN"` and
    # `tee <<< "$API_KEY"` put the value on stdout exactly as `echo` would, and
    # the gate used to be echo|printf only. `<<<` is enough on its own — no
    # command reads a here-string without emitting or storing it.
    if (s ~ PRINTER || index(s, "<<<") > 0) {
      t = strip_sq(s)
      while (match(t, /\$\([^()]*\)/)) {
        inner = substr(t, RSTART + 2, RLENGTH - 3)
        if (inner ~ PRINTER && toupper(inner) ~ CRED) { verdict = "CRED"; next }
        t = substr(t, 1, RSTART - 1) "CMDSUB" substr(t, RSTART + RLENGTH)
      }
      if (toupper(t) ~ CRED) { verdict = "CRED"; next }
    }
  }
  delete subs
}
END { print verdict }
')"

case "$verdict" in
  DUMP) block "$ENV_MSG" ;;
  FILE) block "[secrets-guard] Blocked: that file can contain secrets. Use safe-env for the environment, or open the one non-secret file you actually need." ;;
  CRED) block "[secrets-guard] Blocked: printing a credential-named variable puts its value in the transcript unlabelled, where redaction cannot see it. Use \`safe-env | grep NAME\` to check it is set without printing it." ;;
esac

exit 0
