#!/usr/bin/env bash
# secrets-guard.sh — PreToolUse Bash hook for Claude Code (and Codex).
# Blocks commands that would dump secrets (API keys / tokens) into the session
# transcript: bare env/printenv/export -p/set/declare/history, and reads of
# dotfiles / .env / private keys / /proc/*/environ.
#
# exit 2 + stderr => call denied, stderr shown to the model as feedback.
#
# Two passes, deliberately:
#   A) dump commands  — scanned on QUOTE-STRIPPED text, so words appearing
#      inside a quoted jq/awk/sed program or a regex alternation are not
#      mistaken for real commands (that false positive blocked legitimate
#      config edits before this split existed).
#   B) secret-file reads — scanned on the RAW text, because the path we care
#      about is often quoted and would be erased by pass A's stripping.
set -fuo pipefail

input="$(cat)"
cmd="$(printf '%s' "$input" | jq -r '.tool_input.command // empty' 2>/dev/null)"
[ -n "$cmd" ] || exit 0   # jq missing / no command => fail open, never break the CLI

block () { printf '%s\n' "$1" >&2; exit 2; }

# The backticks are literal text for the reader, not command substitution.
# shellcheck disable=SC2016
ENV_MSG='[secrets-guard] Blocked: bare env/printenv/export/set/declare leaks secrets to the session. Use `safe-env` (values masked), or `echo "$VAR"` for one value.'

# ---------- pass A: dump commands, on quote-stripped text ----------
scan="$(printf '%s' "$cmd" | sed -E "s/'[^']*'/Q/g; s/\"[^\"]*\"/Q/g")"
subs="$(printf '%s\n' "$scan" | sed -E 's/(\|\||&&|;|&|\|)/\n/g')"

while IFS= read -r sub; do
  sub="${sub#"${sub%%[![:space:]]*}"}"          # trim leading whitespace
  [ -z "$sub" ] && continue
  # Word splitting is the point here — the sub-command has to become tokens.
  # `set -f` at the top disables globbing, which is the risk SC2206 warns about.
  # shellcheck disable=SC2206
  toks=($sub)
  i=0
  while [ $i -lt ${#toks[@]} ]; do              # skip wrappers
    case "${toks[$i]}" in
      sudo|rtk|time|command|exec|xargs|nice|nohup) i=$((i+1));;
      *) break;;
    esac
  done
  [ $i -ge ${#toks[@]} ] && continue
  first="${toks[$i]}"
  # only a plain word can be a command name; skip "…", =…, {…, […, $…, *… fragments
  case "$first" in
    [a-zA-Z_]*) ;;
    *) continue;;
  esac
  case "$first" in *[!a-zA-Z0-9_.-]*) continue;; esac
  rest=("${toks[@]:$((i+1))}")

  case "$first" in
    env)
      has_cmd=0
      for t in "${rest[@]}"; do
        case "$t" in -*) ;; *=*) ;; *) has_cmd=1;; esac
      done
      [ "$has_cmd" = "1" ] || block "$ENV_MSG"   # `env VAR=v cmd` is fine; bare dump is not
      ;;
    printenv)  [ ${#rest[@]} -eq 0 ] && block "$ENV_MSG" ;;
    export)    { [ ${#rest[@]} -eq 0 ] || [ "${rest[0]}" = "-p" ] || [ "${rest[0]}" = "-px" ]; } && block "$ENV_MSG" ;;
    set)       [ ${#rest[@]} -eq 0 ] && block "$ENV_MSG" ;;
    history)   block "$ENV_MSG" ;;
    declare|typeset)
      has_assign=0
      for t in "${rest[@]}"; do case "$t" in *=*) has_assign=1;; esac; done
      [ "$has_assign" = "1" ] || block "$ENV_MSG"
      ;;
  esac
done <<< "$subs"

# ---------- pass B: secret-file reads ----------
# The reader has to be a real command, so it is looked for in the QUOTE-STRIPPED
# text; the path may legitimately be quoted, so it is looked for in the RAW one.
# Splitting it this way is what keeps prose out of the decision: a commit message
# containing the words `cat .env` is an argument, not a command, and stripping
# quotes removes it before the reader is ever found.
READERS='(^|[[:space:];|&(])(cat|bat|batcat|tac|nl|head|tail|less|more|view|od|xxd|strings|type|gc)([[:space:]]|$)'

# Path separator: forward slash on Unix, backslash on Windows. Every store below
# accepts either, because a Git Bash or WSL shell is routinely handed a path in
# the other spelling.
S='[/\\]'
# `.env`, and the shell startup files. Windows spells netrc `_netrc`, so the
# leading character is either a dot or an underscore.
SECRET_PATHS='(^|[[:space:]"'"'"'/=])\.env([.[:space:]"'"'"']|$)'
SECRET_PATHS="$SECRET_PATHS|${S}[._](bashrc|zshrc|profile|bash_profile|zshenv|zprofile|netrc)"
# Private keys and certificates.
SECRET_PATHS="$SECRET_PATHS|id_rsa|id_ed25519|id_ecdsa"
SECRET_PATHS="$SECRET_PATHS"'|\.(pem|p12|pfx)([[:space:]"'"'"']|$)'
# Credential stores of the tools a developer actually has installed. These live
# in the same place on Windows, under a backslash path.
SECRET_PATHS="$SECRET_PATHS|\\.aws${S}credentials|\\.docker${S}config\\.json|\\.kube${S}config|\\.azure$S"
SECRET_PATHS="$SECRET_PATHS"'|\.git-credentials|\.npmrc|\.pypirc|\.pgpass|\.my\.cnf'
# Where a Windows user writes `$env:API_KEY = "..."` — the counterpart of
# `.bashrc`, and just as worth not printing.
SECRET_PATHS="$SECRET_PATHS"'|Microsoft\.PowerShell_profile\.ps1'
# Linux-only by construction: no such thing on Windows or macOS.
SECRET_PATHS="$SECRET_PATHS|/proc/[0-9]+/environ"
SECRET_PATHS="($SECRET_PATHS)"

# The reader and the path have to be in the SAME sub-command. Looking for them
# anywhere in the whole line denied things that read nothing:
#
#   rsync -e "ssh -i ~/.ssh/id.pem" host:/src /dst | head -5
#
# `.pem` there is the identity ssh authenticates with, and `head` reads rsync's
# output — two different commands, neither reading a key. Requiring locality
# keeps every real case (`cat .env`, `cat .env | grep X`, `ls && cat .env` all
# have both halves in one sub-command) and drops that class of false positive.
#
# The split has to happen on the RAW text, because the path is what is being
# looked for and pass A's stripping would erase a quoted one. Separators inside
# quotes are not separators, so a quoted jq program holding `;` or `|` stays in
# one piece — hence the quote-aware pass rather than another sed.
raw_subs="$(printf '%s\n' "$cmd" | awk '
{
  out = ""; q = ""
  for (i = 1; i <= length($0); i++) {
    c = substr($0, i, 1)
    if (q == "") {
      if (c == "\"" || c == "\047") { q = c; out = out c; continue }
      if (c == ";" || c == "&" || c == "|") { out = out "\n"; continue }
      out = out c
    } else {
      if (c == q) q = ""
      out = out c
    }
  }
  print out
}')"

while IFS= read -r rawsub; do
  [ -z "$rawsub" ] && continue
  # Same stripping as pass A: the reader must be a command, not a word inside a
  # quoted program.
  subscan="$(printf '%s' "$rawsub" | sed -E "s/'[^']*'/Q/g; s/\"[^\"]*\"/Q/g")"
  if printf '%s' "$subscan" | grep -Eq "$READERS" && printf '%s' "$rawsub" | grep -Eq "$SECRET_PATHS"; then
    block "[secrets-guard] Blocked: that file can contain secrets. grep the one non-secret line you need, or use safe-env."
  fi
done <<< "$raw_subs"

exit 0
