#!/usr/bin/env bash
# safe-env — print env with secret-looking values masked.
# Sanctioned replacement for bare `env` under the secrets-guard hook.
# Masks explicit provider tokens + generic high-entropy strings, so even
# un-prefixed secrets (ZAI hex-dot, TAVILY long token) get redacted.
set -uo pipefail
# gawk when present, awk otherwise — these are program names being assigned,
# not command output.
# shellcheck disable=SC2209
if command -v gawk >/dev/null 2>&1; then AWK=gawk; else AWK=awk; fi

# /usr/bin/env by absolute path, not `env`. PATH resolution is not safe here:
# the uv installer writes a file of its own named `env` into ~/.local/bin — a
# PATH-setup snippet meant to be sourced — and ~/.local/bin comes first, so a
# bare `env` ran that instead, printed nothing, exited 0, and safe-env silently
# produced an empty environment. An empty answer from this tool reads like "no
# variables", not like "the tool is broken", which is the worse failure.
ENV_BIN=/usr/bin/env
[ -x "$ENV_BIN" ] || ENV_BIN=/bin/env
[ -x "$ENV_BIN" ] || { echo "safe-env: no env binary at /usr/bin/env or /bin/env" >&2; exit 3; }

# `-0` and `RS="\0"`, not lines. A value containing a newline used to arrive as
# several records: the first carried NAME= and was judged, and the rest had no
# `=` at all, so the "empty value" branch printed them verbatim with no test of
# any kind. A private key in a variable came out as a masked header followed by
# its own body, and the number in the mask was the length of the header line.
# The PowerShell port never had this — it iterates variables, not lines — and
# the fix is copied from it. review-2026-09-17-safe-env.md item A1.
#
# Both awks on this machine take a NUL record separator (gawk 5.3.2, mawk
# 1.3.4); tests/test_safe_env.sh has a multi-line case, so an awk that cannot
# will fail there rather than leak quietly.
#
# The awk program is single-quoted on purpose: every $ and \ in it belongs to
# awk, not to the shell.
# shellcheck disable=SC2016
"$ENV_BIN" -0 | "$AWK" -v RS='\0' '
function mask(v, l) { l = length(v); return "<REDACTED:" l ">" }
BEGIN {
  RE = "AKIA[0-9A-Z]{16}"
  RE = RE "|(ghp|gho|ghs|ghu|ghr)_[A-Za-z0-9]{36,}"
  RE = RE "|github_pat_[A-Za-z0-9_]{22,}"
  RE = RE "|glpat-[A-Za-z0-9_-]{20,}"
  RE = RE "|xox[baprs]-[A-Za-z0-9-]{10,}"
  RE = RE "|tvly-[A-Za-z0-9-]{10,}"
  RE = RE "|AIza[A-Za-z0-9_-]{35}"
  RE = RE "|(sk|rk)_live_[A-Za-z0-9]{20,}"
  RE = RE "|at-[A-Za-z0-9]{30,}"
  RE = RE "|ATATT[A-Za-z0-9_=.-]{20,}"
  RE = RE "|eyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\."
  RE = RE "|://[^/:@ ]+:[^/:@ ]{3,}@"
  RE = RE "|BEGIN (RSA |EC |OPENSSH |PGP )?PRIVATE KEY"

  # The OpenAI family sits apart because it needs a left boundary, and a
  # boundary cannot go inside RE: the alternatives there are masked whole, and
  # a leading character in the pattern would be masked with them.
  #
  # Unanchored, `sk-` matched inside an ordinary value:
  # `ANTHROPIC_MODEL=zai-sk-glm-4-6-turbo-preview` came back masked — the one
  # variable docs/patterns.md uses as its example of a value that prints.
  #
  # The boundary has to treat `-` as part of a word, not as a separator. A
  # plain word boundary changes nothing here, because the character before
  # `sk-` in that model name IS a hyphen. What a real key has in front of it is
  # a space, a quote, `=`, `:` or the start of the value.
  SK = "(^|[^A-Za-z0-9_-])sk-(or-v1-|proj-|ant-)?[A-Za-z0-9-]{20,}"

  # What the NAME says, for the values whose shape says nothing. A classic
  # Atlassian API token is 24 characters of letters and digits — the same shape
  # as a build id, a short hash or a bucket name — so no pattern above can take
  # it without masking half of an ordinary environment. The name can.
  CRED = "(PASSWD|PASSWORD|PASSPHRASE|TOKEN|SECRET|API_?KEY|APIKEY"
  CRED = CRED "|AUTH_?TOKEN|ACCESS_?KEY|SECRET_?KEY|CLIENT_?SECRET"
  CRED = CRED "|PRIVATE_?KEY|CREDENTIAL)"

  # The name has to be a WHOLE underscore-separated component, not a substring
  # of one. Matched as a substring, PASS masked BYPASS_CACHE and PASSENGER_ROOT
  # — configuration silently deleted from the output, which is the failure that
  # gets a tool switched off. bin/secrets-guard carries the same list and had
  # the same defect; tests/test_policy.sh asks both the same names.
  #
  # PASS needs a neighbour: DB_PASS is how half the compose files in existence
  # spell a password, but a lone PASS is as likely to be a counter. PASSWORD,
  # PASSWD and PASSPHRASE say it on their own.
  CRED_VAR = "^([A-Za-z0-9]+_)*" CRED "(_[A-Za-z0-9]+)*$"
  CRED_VAR = CRED_VAR "|^(([A-Za-z0-9]+_)+PASS(_[A-Za-z0-9]+)*"
  CRED_VAR = CRED_VAR "|PASS(_[A-Za-z0-9]+)+)$"

  # Standard base64 — the commonest encoding for a random secret, and the one
  # shape none of the fallbacks below could take: `+`, `/` and `=` are outside
  # [A-Za-z0-9_-], so any one of them broke every run long enough to match. The
  # same mechanism as the key.signature miss in docs/patterns.md.
  #
  # A path is the false positive to avoid, because `/` is in the alphabet: a
  # long enough one is letters, digits and slashes and nothing else. Values
  # starting with `/`, `~` or `.` are excluded for that reason — a relative
  # path with no leading dot and over forty characters is the residue, and it
  # is rarer than the secret this catches.
  B64 = "^[A-Za-z0-9+/=]{40,}$"
}
# A credential-named variable whose value could be one. Three things keep this
# from masking half the environment: a path is configuration, not a secret; so
# is a flag; and nothing shorter than eight characters is worth hiding, which
# is what keeps TOKENIZERS_PARALLELISM=false readable.
function named_credential(key, val) {
  if (toupper(key) !~ CRED_VAR)                 return 0
  if (length(val) < 8)                          return 0
  if (val ~ /^[~.]?[\/\\]/)                     return 0     # /path, ./path, ~/path, and the backslash spellings
  if (val ~ /^[A-Za-z]:[\/\\]/)                 return 0     # C:/path, C:\path — Git Bash and WSL are handed these
  if (tolower(val) ~ /^(true|false|yes|no|on|off|[0-9]+)$/) return 0
  return 1
}
{
  # $1 is no longer the name: with RS="\0" a record is a whole NAME=value pair,
  # newlines and all, so the split is the first `=` and nothing else.
  eq = index($0, "=")
  if (eq == 0) next                 # not a NAME=value pair; env does not emit these
  key = substr($0, 1, eq - 1)
  val = substr($0, eq + 1)
  # `NAME=`, not a bare `NAME`: it is what env itself prints, it is what
  # grep "^NAME=" expects, and a bare name reads as a variable with no value
  # rather than one with an empty value. The port already did this.
  if (val == "") { print key "="; next }
  # explicit provider token / embedded secret
  if (val ~ RE)                                                          { print key "=" mask(val); next }
  if (val ~ SK)                                                          { print key "=" mask(val); next }
  if (tolower($0) ~ /identified by ['"'"'"][^'"'"'"]{6,}/)                { print key "=" mask(val); next }
  # generic high-entropy fallbacks (catch unprefixed keys: hex, hex.base64, long tokens)
  if (val ~ /^[A-Fa-f0-9]{32,}$/)                                         { print key "=" mask(val); next }
  if (val ~ /^[A-Za-z0-9]{20,}\.[A-Za-z0-9_-]{8,}$/)                      { print key "=" mask(val); next }
  if (val ~ /[A-Za-z0-9_-]{40,}/ && val ~ /[A-Za-z0-9_-]\.[A-Za-z0-9_-]/)  { print key "=" mask(val); next }
  if (val ~ /^[A-Za-z0-9_-]{40,}$/)                                       { print key "=" mask(val); next }
  if (val ~ B64 && val !~ /^[\/~.]/)                                      { print key "=" mask(val); next }
  # last, so a shape match still wins and the name only decides the leftovers
  if (named_credential(key, val))                                         { print key "=" mask(val); next }
  print key "=" val
}'
