#!/usr/bin/env bash
# secrets-redact — PostToolUse hook for Claude Code.
#
# secrets-guard stops a command that would *read* a secret. It cannot stop a
# command whose output happens to *contain* one: it sees the command line, not
# the result. A program invoked with a password prints that password back —
#
#     croc send file.txt
#     On the other computer, run:
#       croc --relay HOST --pass deadbeefdeadbeefdeadbeefdeadbeef code-word
#
# — and nothing in a PreToolUse hook can know that in advance.
#
# This hook runs after the tool and replaces the output before the model sees
# it, via hookSpecificOutput.updatedToolOutput. Two tiers, deliberately:
#
#   tier 1  provider-shaped tokens (ghp_, glpat-, AKIA, JWT, private key
#           blocks, credentials inside a URL). Unambiguous — masked anywhere.
#
#   tier 2  a high-entropy run only when a label on the same line says it is a
#           secret: --pass, --token, password=, Authorization: Bearer, or an
#           assignment whose NAME reads like a credential. Tier 1's patterns
#           cannot catch an unprefixed hex password, and matching bare hex
#           everywhere would redact every md5sum and git SHA the model needs.
#           The label is what separates the two.
#
# Fails open: no jq, unparsable input, or nothing to mask => exit 0 with no
# output, which leaves the tool result exactly as it was. A hook that breaks
# the session is worse than a hook that misses one secret.
#
#   echo '<hook json>' | secrets-redact      Claude Code hook, wired by install.sh
#   … | secrets-redact --warn-only           Codex hook: report that a credential
#                                            is in the output, without repeating
#                                            it. Codex cannot replace a result.
#   … | secrets-redact --filter              text in, masked text out; what the
#                                            Opencode plugin calls, and usable
#                                            by hand in a pipe. Needs no jq.
#   secrets-redact --self-test               mask a sample, print the result
set -uo pipefail

# gawk when present, awk otherwise — program names, not command output.
# shellcheck disable=SC2209
if command -v gawk >/dev/null 2>&1; then AWK=gawk; else AWK=awk; fi

# ── the masking program ─────────────────────────────────────────────────────
# TIER 1 is character-for-character the RE built in bin/safe-env. The two are
# kept in step by tests/test_redact.sh, which diffs them; edit both or neither.
# Single-quoted on purpose: every $ and \ belongs to awk, not to the shell.
# shellcheck disable=SC2016
REDACT_AWK='
function mask(v) { return "<REDACTED:" length(v) ">" }
BEGIN {
  RE = "AKIA[0-9A-Z]{16}"
  RE = RE "|(ghp|gho|ghs|ghu|ghr)_[A-Za-z0-9]{36,}"
  RE = RE "|github_pat_[A-Za-z0-9_]{22,}"
  RE = RE "|glpat-[A-Za-z0-9_-]{20,}"
  RE = RE "|xox[baprs]-[A-Za-z0-9-]{10,}"
  RE = RE "|tvly-[A-Za-z0-9-]{10,}"
  RE = RE "|AIza[A-Za-z0-9_-]{35}"
  RE = RE "|(sk|rk)_live_[A-Za-z0-9]{20,}"
  RE = RE "|sk-(or-v1-|proj-|ant-)?[A-Za-z0-9-]{20,}"
  RE = RE "|at-[A-Za-z0-9]{30,}"
  RE = RE "|ATATT[A-Za-z0-9_=.-]{20,}"
  RE = RE "|eyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\."
  RE = RE "|://[^/:@ ]+:[^/:@ ]{3,}@"
  RE = RE "|BEGIN (RSA |EC |OPENSSH |PGP )?PRIVATE KEY"

  # tier 2: what a secret is called, and what one looks like.
  LABEL = "(--?)?(pass|passwd|password|pass-phrase|passphrase|token|secret|"
  LABEL = LABEL "api[-_]?key|apikey|auth[-_]?token|access[-_]?key|"
  LABEL = LABEL "client[-_]?secret|private[-_]?key|credential|"
  # Cloud keys with no distinctive prefix. AWS is covered by tier 1 (AKIA…),
  # Huawei and OpenStack are not: their access key is 20 characters of
  # uppercase and digits, the secret 40 of base62 — shapes that also describe a
  # git SHA and half the identifiers in ordinary output, so tier 1 cannot take
  # them. The variable name is the only reliable signal, and it is right there.
  LABEL = LABEL "hw[-_]?(access|secret)([-_]?key)?|huaweicloud?[-_]?[a-z_]*key|"
  LABEL = LABEL "os[-_](access|secret)[-_]?key)s?"
  # 16 is the floor: an md5 is 32 and a git SHA is 40, so length alone can
  # never decide this — only the label can.
  VALUE = "[A-Za-z0-9+/=_.~-]{16,}"
  hits = 0
}

# Tier 2 fires on a label followed by any long-enough run of token characters,
# and that description also fits a name. Measured 2026-09-14 over 69 Codex
# transcripts: of 51 flagged lines, about 35 were an identifier in source code,
# a metavar in --help output, a Terraform reference or a Kubernetes object name.
#
# In a report that is noise. In the hook it is worse: reading a file with
# `outputTokens: usage.outputTokens` handed the model `<REDACTED:18>` where the
# name should be, and `--anthropic-api-key ANTHROPIC_API_KEY` lost the metavar
# that says which variable to set.
#
# A credential rarely looks like a name. It does not read as dotted fields, it
# is not one SCREAMING_SNAKE word, and it is not lowercase words joined by
# hyphens. Each rule below is narrow on purpose, and each has a case in
# tests/test_redact.sh asserting a real secret of that shape still goes:
# a Huawei access key is 20 characters of uppercase and digits, which is why
# the metavar rule demands an underscore rather than matching upper case alone.
function is_name(v) {
  if (v ~ /^[$]/)                                     return 1   # $VAR, ${VAR}
  if (v ~ /^(var|data|local|module|each|self)\./)     return 1   # Terraform reference
  if (v ~ /^[~.]?\//)                                 return 1   # /path ./path ~/path
  if (v ~ /\./ && v ~ /^[A-Za-z_][A-Za-z_.]*$/)       return 1   # pkg.field.name
  if (v ~ /^[A-Z][A-Z0-9]*(_[A-Z0-9]+)+$/)            return 1   # ANTHROPIC_API_KEY
  if (v ~ /^[a-z]+(-[a-z]+)+$/)                       return 1   # prometheus-operator
  if (v ~ /^[a-z]+(_[a-z]+)+$/)                       return 1   # aws_secrets_manager
  return 0
}

# Mask every occurrence of PAT in the current line, counting the hits.
function scrub(pat,   out, rest, m, before) {
  out = ""; rest = $0
  while (match(rest, pat)) {
    before = substr(rest, 1, RSTART - 1)
    m = substr(rest, RSTART, RLENGTH)
    out = out before mask(m)
    rest = substr(rest, RSTART + RLENGTH)
    hits++
  }
  $0 = out rest
}

# Mask only the value that follows a labelled secret, never the label itself:
# `--pass 6310…` must stay readable as `--pass <REDACTED:32>`, otherwise the
# model cannot tell what was removed.
#
# Matching runs against a lower-cased copy of the line, and every offset is then
# applied to the original. The label list is written in lower case, and awk
# matches case-sensitively, so before this `TOKEN: 6310…` and `TOKEN=6310…` came
# through untouched while `token: 6310…` was masked. Uppercase is how a token
# appears in most output there is — an env dump, a config echo, a CI log.
#
# gawk has IGNORECASE and mawk does not, and this file runs under either, so the
# fix cannot be a flag. tolower() preserves length for the ASCII these patterns
# describe, which is what makes the offsets transferable.
function scrub_labelled(sep,   pat, out, rest, lrest, m, head, val, mstart, mlen, vstart) {
  pat = LABEL sep VALUE
  out = ""; rest = $0; lrest = tolower($0)
  while (match(lrest, pat)) {
    # Keep the outer match position before matching again inside it: the second
    # match overwrites RSTART, and re-finding the text with index() can land on
    # an earlier occurrence the outer pattern spanned differently.
    mstart = RSTART; mlen = RLENGTH
    m = substr(rest, mstart, mlen)
    # The head is the label and its separator, anchored at the front — not
    # "whatever is left once VALUE has taken the longest suffix it can". VALUE
    # admits `=` and `_`, so on `password=6310…` that reading matched the whole
    # string from the first character and masked the label with the value:
    # `<REDACTED:41>` instead of `password=<REDACTED:32>`. `--pass 6310…`
    # escaped it only because a space is not in VALUE. Losing the label defeats
    # the point of tier 2 — the model is supposed to see what was removed.
    if (match(tolower(m), "^" LABEL sep) == 0) break
    vstart = RLENGTH + 1
    head = substr(m, 1, vstart - 1)
    val = substr(m, vstart)
    if (is_name(val)) {
      out = out substr(rest, 1, mstart - 1) head val
    } else {
      out = out substr(rest, 1, mstart - 1) head mask(val)
      hits++
    }
    rest  = substr(rest,  mstart + mlen)
    lrest = substr(lrest, mstart + mlen)
  }
  $0 = out rest
}

{
  scrub(RE)
  scrub_labelled("[[:space:]]*[=:][[:space:]]*\"?")   # password=X, TOKEN: X
  scrub_labelled("[[:space:]]+\"?")                   # --pass X, --token X
  print
}
END { exit (hits > 0 ? 0 : 1) }
'

redact () { "$AWK" "$REDACT_AWK"; }

if [ "${1:-}" = "--self-test" ]; then
    printf '%s\n' \
        'croc --relay h:9009 --pass deadbeefdeadbeefdeadbeefdeadbeef code-word' \
        'md5sum: deadbeefdeadbeefdeadbeefdeadbeef  big.bin' \
        'export GH=ghp_0123456789abcdefghijklmnopqrstuvwxyzAB' | redact
    exit 0
fi

# Plain text in, masked text out, no JSON either side. This is what the Opencode
# plugin calls: its hook hands over the tool output as a string and expects a
# string back, so wrapping it in the Claude Code payload shape only to unwrap it
# again would be ceremony. Needs no jq, which also makes it the mode to reach
# for by hand, in a pipe.
#
# Exit 0 means something was masked, 1 means the text came through unchanged —
# so a caller can skip the assignment rather than rewrite a string with itself.
if [ "${1:-}" = "--filter" ]; then
    redact
    exit $?
fi

# ── hook mode ───────────────────────────────────────────────────────────────
command -v jq >/dev/null 2>&1 || exit 0     # fail open, never break the CLI

# The payload is written to a file once and never held in a shell variable or
# passed as an argument. Both of those have limits this hook used to hit in
# silence:
#
#   `jq --arg out "$big"` dies with "Argument list too long" at MAX_ARG_STRLEN,
#   which is 128 KB on Linux and has nothing to do with ARG_MAX as a whole. The
#   `|| exit 0` after it then failed open. Measured 2026-09-14: output of 96 KB
#   was masked, output of 128 KB went to the model with the token intact — and
#   nothing anywhere said so.
#
# So: `--rawfile` instead of `--arg`, files instead of `$(...)`, and jq reads
# the payload from disk each time rather than from a copy in the environment.
# Command substitution also strips trailing newlines, so a stream captured that
# way could no longer be compared with what came back — this hook redacts, it
# does not reformat, and `--rawfile` is byte-exact where `$(cat)` is not.
tmp="$(mktemp -d)" || exit 0
trap 'rm -rf "$tmp"' EXIT

cat > "$tmp/payload" || exit 0
[ -s "$tmp/payload" ] || exit 0

# ── warn-only mode, where a result cannot be replaced ───────────────────────
# Two events land here, and neither can be rewritten.
#
# Codex's PostToolUseOutcome carries should_block, additional_contexts and
# feedback_message, and nothing that replaces output.
#
# Claude Code's `PostToolUseFailure` is the same shape of problem and the more
# expensive one. A command that exits non-zero does not fire `PostToolUse` at
# all; it fires this event instead, whose only documented return field is
# `additionalContext`. So for a failed command there is no masking to be had —
# not because the hook declines, but because the contract has no slot for a
# replacement.
#
# That is the case this whole file was written for. Measured 2026-09-14: a
# `git remote -v` that exited 1 because a later command in the same call failed
# put a GitLab token into the transcript in full. A failing command is exactly
# when a credential surfaces — a URL carrying a password, an auth error quoting
# the key — and it is the one path where the value cannot be taken back.
#
# What is left is to say so. The model learns that a credential is now in the
# transcript, which is what turns a silent leak into a rotation. The message
# never repeats the value and never says which command produced it: both would
# put a second copy in the very transcript being warned about.
if [ "${1:-}" = "--warn-only" ]; then
    # Claude Code puts a failed command's output in a top-level `error` string —
    # first line `Exit code N`, then stdout and stderr interleaved as one block.
    # Codex names the shell result `output`; a successful Claude Code call
    # splits it into stdout and stderr. Read every shape: detection costs
    # nothing and a field that does not exist contributes nothing.
    # Every string anywhere in the result, plus the failure event's top-level
    # `error`. Detection can afford recursive descent where replacement cannot:
    # nothing is rebuilt here, so an unfamiliar schema costs a false positive at
    # worst, never a mangled result.
    #
    # That asymmetry is why this mode exists for `Edit`, `Write` and the MCP
    # tools. An Edit result carries the file in four places — `originalFile`,
    # `oldString`, `newString` and `structuredPatch[].lines` — and an MCP result
    # is an array of content blocks. Masking one field of those and not the rest
    # would read as coverage while leaving the same secret in the next field
    # along. Saying "a credential is in this result" is the honest service.
    jq -j 'try ([ (.error? | select(type == "string")),
                  (.tool_response? | .. | strings) ]
                | join("\n"))' \
       < "$tmp/payload" > "$tmp/warn" 2>/dev/null
    [ -s "$tmp/warn" ] || exit 0

    hits="$(redact < "$tmp/warn" | grep -c '<REDACTED:' || true)"
    [ "${hits:-0}" -gt 0 ] || exit 0

    # The event has to be named back exactly as it arrived. A hook wired to
    # PostToolUseFailure that answers "PostToolUse" is answering a question
    # nobody asked, and the reply is dropped.
    jq -c --argjson n "$hits" '
      {
        hookSpecificOutput: {
          hookEventName: (.hook_event_name // "PostToolUse"),
          additionalContext: (
            "[secrets-redact] This output contains \($n) credential-shaped value(s). " +
            "It cannot be removed here, so it is already in the transcript. Do not " +
            "repeat it, do not echo the command that produced it, and tell the user " +
            "the value has to be rotated."
          )
        }
      }' < "$tmp/payload" 2>/dev/null || exit 0
    exit 0
fi

# A result reaches this hook in one of four shapes, and they are not
# interchangeable — replacing an output with the wrong schema is worse than not
# replacing it:
#
#   streams   {"stdout": …, "stderr": …}      a shell call that succeeded
#   file      {"file": {"content": …}, …}     what the Read tool returns
#   content   {"content": "…"}                one blob; Grep returns this
#   string    "…"                             a result handed over whole
#
# The string branch is defensive, not a path any assistant here is known to
# take. It was added on 2026-09-14 on the reading that a failed `git remote -v`
# arrived this way, because that is how the transcript *stores* a failed
# result. It is not how the hook is *called*: Claude Code routes a non-zero
# exit to PostToolUseFailure, where `error` is a top-level string and nothing
# can replace it — see the --warn-only branch. Opencode never reaches JSON mode
# at all; its plugin calls --filter. Kept because it costs one comparison and
# fails closed on a shape nobody has ruled out.
#
# Detect the shape first, then rebuild in that same shape.
shape="$(jq -r '
    (.tool_response // empty) as $r
    | if   ($r | type) == "string"               then "string"
      elif ($r | type) != "object"               then "other"
      elif ($r.stdout? | type) == "string"
        or ($r.stderr? | type) == "string"       then "streams"
      elif ($r.file?.content? | type) == "string" then "file"
      elif ($r.content? | type) == "string"      then "content"
      else "other"
      end' < "$tmp/payload" 2>/dev/null)"

CTX="[secrets-redact] A secret-shaped value in this output was replaced with <REDACTED:length>. Do not try to recover it, and do not print the command that produced it."

# awk's `print` terminates every line, so a stream that did not end in a
# newline comes back one byte longer. Take that byte off again.
# `wc -l` counts newlines, so a one-byte tail reports 1 exactly when that byte
# is the newline.
ends_nl () { [ -s "$1" ] && [ "$(tail -c1 "$1" | wc -l)" -eq 1 ]; }
untrail () {   # $1 masked file, $2 the file it was made from
    if [ -s "$1" ] && ! ends_nl "$2"; then
        printf '%s' "$(cat "$1")" > "$1.trim" && mv "$1.trim" "$1"
    fi
}

# ── one blob: a bare string, {"content": …}, or Read's {"file":{"content"…}} ─
if [ "$shape" = "string" ] || [ "$shape" = "content" ] || [ "$shape" = "file" ]; then
    jq -j --arg s "$shape" '
        try (if   $s == "string" then .tool_response
             elif $s == "file"   then .tool_response.file.content
             else .tool_response.content end) // empty' \
        < "$tmp/payload" > "$tmp/in.one" 2>/dev/null
    [ -s "$tmp/in.one" ] || exit 0

    redact < "$tmp/in.one" > "$tmp/one"; hit_one=$?
    [ "$hit_one" -eq 0 ] || exit 0                       # nothing matched
    untrail "$tmp/one" "$tmp/in.one"

    # --rawfile, not --arg: see the note above mktemp. A Read of a large file is
    # the ordinary case here, not the exotic one, so the 128 KB argument limit
    # would be hit on the first real secret this branch was written for.
    jq -c --rawfile one "$tmp/one" --arg s "$shape" --arg ctx "$CTX" '
        {
          hookSpecificOutput: {
            hookEventName: "PostToolUse",
            updatedToolOutput: (
              if   $s == "string" then $one
              elif $s == "file"   then ((.tool_response // {})
                                        + {file: ((.tool_response.file // {})
                                                  + {content: $one})})
              else ((.tool_response // {}) + {content: $one}) end),
            additionalContext: $ctx
          }
        }' < "$tmp/payload" 2>/dev/null || exit 0
    exit 0
fi

[ "$shape" = "streams" ] || exit 0

# ── the two streams a shell produces ────────────────────────────────────────
jq -j 'try (.tool_response.stdout // empty)' < "$tmp/payload" > "$tmp/in.out" 2>/dev/null
jq -j 'try (.tool_response.stderr // empty)' < "$tmp/payload" > "$tmp/in.err" 2>/dev/null
[ -s "$tmp/in.out" ] || [ -s "$tmp/in.err" ] || exit 0

redact < "$tmp/in.out" > "$tmp/out"; hit_out=$?
redact < "$tmp/in.err" > "$tmp/err"; hit_err=$?
[ "$hit_out" -eq 0 ] || [ "$hit_err" -eq 0 ] || exit 0   # nothing matched

untrail "$tmp/out" "$tmp/in.out"
untrail "$tmp/err" "$tmp/in.err"

# Rebuild from the original tool_response so fields this hook knows nothing
# about (interrupted, isImage, and whatever is added later) survive intact.
jq -c --rawfile out "$tmp/out" --rawfile err "$tmp/err" --arg ctx "$CTX" '
    {
      hookSpecificOutput: {
        hookEventName: "PostToolUse",
        updatedToolOutput: ((.tool_response // {}) + {stdout: $out, stderr: $err}),
        additionalContext: $ctx
      }
    }' < "$tmp/payload" 2>/dev/null || exit 0
