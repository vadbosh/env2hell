#!/usr/bin/env bash
# secrets-redact — PostToolUse hook for Claude Code.
#
# secrets-guard stops a command that would *read* a secret. It cannot stop a
# command whose output happens to *contain* one: it sees the command line, not
# the result. A program invoked with a password prints that password back —
#
#     croc send file.txt
#     On the other computer, run:
#       croc --relay HOST --pass deadbeefdeadbeefdeadbeefdeadbeef code-word
#
# — and nothing in a PreToolUse hook can know that in advance.
#
# This hook runs after the tool and replaces the output before the model sees
# it, via hookSpecificOutput.updatedToolOutput. Two tiers, deliberately:
#
#   tier 1  provider-shaped tokens (ghp_, glpat-, AKIA, JWT, private key
#           blocks, credentials inside a URL). Unambiguous — masked anywhere.
#
#   tier 2  a high-entropy run only when a label on the same line says it is a
#           secret: --pass, --token, password=, Authorization: Bearer, or an
#           assignment whose NAME reads like a credential. Tier 1's patterns
#           cannot catch an unprefixed hex password, and matching bare hex
#           everywhere would redact every md5sum and git SHA the model needs.
#           The label is what separates the two.
#
# Fails open: no jq, unparsable input, or nothing to mask => exit 0 with no
# output, which leaves the tool result exactly as it was. A hook that breaks
# the session is worse than a hook that misses one secret.
#
#   echo '<hook json>' | secrets-redact      Claude Code hook, wired by install.sh
#   … | secrets-redact --filter              text in, masked text out; what the
#                                            Opencode plugin calls, and usable
#                                            by hand in a pipe. Needs no jq.
#   secrets-redact --self-test               mask a sample, print the result
set -uo pipefail

# gawk when present, awk otherwise — program names, not command output.
# shellcheck disable=SC2209
if command -v gawk >/dev/null 2>&1; then AWK=gawk; else AWK=awk; fi

# ── the masking program ─────────────────────────────────────────────────────
# TIER 1 is character-for-character the RE built in bin/safe-env. The two are
# kept in step by tests/test_redact.sh, which diffs them; edit both or neither.
# Single-quoted on purpose: every $ and \ belongs to awk, not to the shell.
# shellcheck disable=SC2016
REDACT_AWK='
function mask(v) { return "<REDACTED:" length(v) ">" }
BEGIN {
  RE = "AKIA[0-9A-Z]{16}"
  RE = RE "|(ghp|gho|ghs|ghu|ghr)_[A-Za-z0-9]{36,}"
  RE = RE "|github_pat_[A-Za-z0-9_]{22,}"
  RE = RE "|glpat-[A-Za-z0-9_-]{20,}"
  RE = RE "|xox[baprs]-[A-Za-z0-9-]{10,}"
  RE = RE "|tvly-[A-Za-z0-9-]{10,}"
  RE = RE "|AIza[A-Za-z0-9_-]{35}"
  RE = RE "|(sk|rk)_live_[A-Za-z0-9]{20,}"
  RE = RE "|sk-(or-v1-|proj-|ant-)?[A-Za-z0-9-]{20,}"
  RE = RE "|at-[A-Za-z0-9]{30,}"
  RE = RE "|eyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\."
  RE = RE "|://[^/:@ ]+:[^/:@ ]{3,}@"
  RE = RE "|BEGIN (RSA |EC |OPENSSH |PGP )?PRIVATE KEY"

  # tier 2: what a secret is called, and what one looks like.
  LABEL = "(--?)?(pass|passwd|password|pass-phrase|passphrase|token|secret|"
  LABEL = LABEL "api[-_]?key|apikey|auth[-_]?token|access[-_]?key|"
  LABEL = LABEL "client[-_]?secret|private[-_]?key|credential)s?"
  # 16 is the floor: an md5 is 32 and a git SHA is 40, so length alone can
  # never decide this — only the label can.
  VALUE = "[A-Za-z0-9+/=_.~-]{16,}"
  hits = 0
}

# Mask every occurrence of PAT in the current line, counting the hits.
function scrub(pat,   out, rest, m, before) {
  out = ""; rest = $0
  while (match(rest, pat)) {
    before = substr(rest, 1, RSTART - 1)
    m = substr(rest, RSTART, RLENGTH)
    out = out before mask(m)
    rest = substr(rest, RSTART + RLENGTH)
    hits++
  }
  $0 = out rest
}

# Mask only the value that follows a labelled secret, never the label itself:
# `--pass 6310…` must stay readable as `--pass <REDACTED:32>`, otherwise the
# model cannot tell what was removed.
function scrub_labelled(sep,   pat, out, rest, m, head, val, mstart, mlen, vstart) {
  pat = LABEL sep VALUE
  out = ""; rest = $0
  while (match(rest, pat)) {
    # Keep the outer match position before matching again inside it: the second
    # match overwrites RSTART, and re-finding the text with index() can land on
    # an earlier occurrence the outer pattern spanned differently.
    mstart = RSTART; mlen = RLENGTH
    m = substr(rest, mstart, mlen)
    if (match(m, VALUE "$") == 0) break
    vstart = RSTART
    head = substr(m, 1, vstart - 1)
    val = substr(m, vstart)
    out = out substr(rest, 1, mstart - 1) head mask(val)
    rest = substr(rest, mstart + mlen)
    hits++
  }
  $0 = out rest
}

{
  scrub(RE)
  scrub_labelled("[[:space:]]*[=:][[:space:]]*\"?")   # password=X, TOKEN: X
  scrub_labelled("[[:space:]]+\"?")                   # --pass X, --token X
  print
}
END { exit (hits > 0 ? 0 : 1) }
'

redact () { "$AWK" "$REDACT_AWK"; }

if [ "${1:-}" = "--self-test" ]; then
    printf '%s\n' \
        'croc --relay h:9009 --pass deadbeefdeadbeefdeadbeefdeadbeef code-word' \
        'md5sum: deadbeefdeadbeefdeadbeefdeadbeef  big.bin' \
        'export GH=ghp_0123456789abcdefghijklmnopqrstuvwxyzAB' | redact
    exit 0
fi

# Plain text in, masked text out, no JSON either side. This is what the Opencode
# plugin calls: its hook hands over the tool output as a string and expects a
# string back, so wrapping it in the Claude Code payload shape only to unwrap it
# again would be ceremony. Needs no jq, which also makes it the mode to reach
# for by hand, in a pipe.
#
# Exit 0 means something was masked, 1 means the text came through unchanged —
# so a caller can skip the assignment rather than rewrite a string with itself.
if [ "${1:-}" = "--filter" ]; then
    redact
    exit $?
fi

# ── hook mode ───────────────────────────────────────────────────────────────
command -v jq >/dev/null 2>&1 || exit 0     # fail open, never break the CLI

input="$(cat)"
[ -n "$input" ] || exit 0

# Everything goes through files, never through `$(...)`: command substitution
# strips trailing newlines, so a stream captured that way can no longer be
# compared with what came back. This hook redacts, it does not reformat, and a
# transcript that silently loses its last newline is a difference the model can
# see. `jq -j` for the same reason — it adds no newline of its own.
tmp="$(mktemp -d)" || exit 0
trap 'rm -rf "$tmp"' EXIT

# Only the streams a shell produces. Other tools carry other shapes, and
# replacing an output with the wrong schema is worse than not replacing it.
printf '%s' "$input" | jq -j 'try (.tool_response.stdout // empty)' > "$tmp/in.out" 2>/dev/null
printf '%s' "$input" | jq -j 'try (.tool_response.stderr // empty)' > "$tmp/in.err" 2>/dev/null
[ -s "$tmp/in.out" ] || [ -s "$tmp/in.err" ] || exit 0

redact < "$tmp/in.out" > "$tmp/out"; hit_out=$?
redact < "$tmp/in.err" > "$tmp/err"; hit_err=$?
[ "$hit_out" -eq 0 ] || [ "$hit_err" -eq 0 ] || exit 0   # nothing matched

# awk's `print` terminates every line, so a stream that did not end in a
# newline comes back one byte longer. Take that byte off again.
# `wc -l` counts newlines, so a one-byte tail reports 1 exactly when that byte
# is the newline.
ends_nl () { [ -s "$1" ] && [ "$(tail -c1 "$1" | wc -l)" -eq 1 ]; }
for s in out err; do
    if [ -s "$tmp/$s" ] && ! ends_nl "$tmp/in.$s"; then
        printf '%s' "$(cat "$tmp/$s")" > "$tmp/$s.trim" && mv "$tmp/$s.trim" "$tmp/$s"
    fi
done

new_out="$(cat "$tmp/out"; printf X)"; new_out="${new_out%X}"
new_err="$(cat "$tmp/err"; printf X)"; new_err="${new_err%X}"

# Rebuild from the original tool_response so fields this hook knows nothing
# about (interrupted, isImage, and whatever is added later) survive intact.
printf '%s' "$input" | jq -c \
    --arg out "$new_out" --arg err "$new_err" '
    {
      hookSpecificOutput: {
        hookEventName: "PostToolUse",
        updatedToolOutput: ((.tool_response // {}) + {stdout: $out, stderr: $err}),
        additionalContext: "[secrets-redact] A secret-shaped value in this output was replaced with <REDACTED:length>. Do not try to recover it, and do not print the command that produced it."
      }
    }' 2>/dev/null || exit 0
