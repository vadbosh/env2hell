#!/usr/bin/env bash
# secrets-redact — PostToolUse hook for Claude Code.
#
# secrets-guard stops a command that would *read* a secret. It cannot stop a
# command whose output happens to *contain* one: it sees the command line, not
# the result. A program invoked with a password prints that password back —
#
#     croc send file.txt
#     On the other computer, run:
#       croc --relay HOST --pass deadbeefdeadbeefdeadbeefdeadbeef code-word
#
# — and nothing in a PreToolUse hook can know that in advance.
#
# This hook runs after the tool and replaces the output before the model sees
# it, via hookSpecificOutput.updatedToolOutput. Two tiers, deliberately:
#
#   tier 1  provider-shaped tokens (ghp_, glpat-, AKIA, JWT, credentials inside
#           a URL). Unambiguous — masked anywhere. A private key is the one
#           member of this tier that is a *block* rather than a match: the
#           header line starts it, the footer ends it, and the body between
#           them is replaced line for line.
#
#   tier 2  a high-entropy run only when a label on the same line says it is a
#           secret: --pass, --token, password=, Authorization: Bearer, or an
#           assignment whose NAME reads like a credential. Tier 1's patterns
#           cannot catch an unprefixed hex password, and matching bare hex
#           everywhere would redact every md5sum and git SHA the model needs.
#           The label is what separates the two.
#
# Fails open: no jq, unparsable input, or nothing to mask => exit 0 with no
# output, which leaves the tool result exactly as it was. A hook that breaks
# the session is worse than a hook that misses one secret.
#
#   echo '<hook json>' | secrets-redact      Claude Code hook, wired by install.sh
#   … | secrets-redact --warn-only           Codex hook: report that a credential
#                                            is in the output, without repeating
#                                            it. Codex cannot replace a result.
#   … | secrets-redact --filter              text in, masked text out; what the
#                                            Opencode plugin calls, and usable
#                                            by hand in a pipe. Needs no jq.
#   secrets-redact --self-test               mask a sample, print the result
#
# The exit code means different things in the two roles, and `1` is the one to
# be careful with:
#
#   as a hook (JSON in)     always 0. Even "nothing matched", even "no jq".
#                           That is the fail-open contract above: an assistant
#                           must never see this hook fail.
#   as a filter (text in)   0 something was masked, 1 the text came through
#                           unchanged. Grep's convention, so that a caller can
#                           skip the assignment rather than rewrite a string
#                           with itself — and a trap for `set -e` or a `&&`
#                           chain, where 1 reads as failure.
#
# So: `secrets-redact --filter < x > y` inside `set -e` stops the script on
# perfectly ordinary output. Use `|| true` there, or read the code deliberately.
set -uo pipefail

# gawk when present, awk otherwise — program names, not command output.
# shellcheck disable=SC2209
if command -v gawk >/dev/null 2>&1; then AWK=gawk; else AWK=awk; fi

# ── the masking program ─────────────────────────────────────────────────────
# TIER 1 is character-for-character the RE built in bin/safe-env. The two are
# kept in step by tests/test_redact.sh, which diffs them; edit both or neither.
# Single-quoted on purpose: every $ and \ belongs to awk, not to the shell.
# shellcheck disable=SC2016
REDACT_AWK='
function mask(v) { return "<REDACTED:" length(v) ">" }
# Already a mask: the line went through a masker once before -- this hook on an
# earlier read, or the tool that printed it. Masked again it reported the
# length of the marker instead of the secret, and it counted as a hit, so the
# hook told the model a secret had been removed from text that held none.
function is_mask(v) { return v ~ /^<REDACTED:[0-9]+>$/ }
BEGIN {
  RE = "AKIA[0-9A-Z]{16}"
  RE = RE "|(ghp|gho|ghs|ghu|ghr)_[A-Za-z0-9]{36,}"
  RE = RE "|github_pat_[A-Za-z0-9_]{22,}"
  RE = RE "|glpat-[A-Za-z0-9_-]{20,}"
  RE = RE "|xox[baprs]-[A-Za-z0-9-]{10,}"
  RE = RE "|tvly-[A-Za-z0-9-]{10,}"
  RE = RE "|AIza[A-Za-z0-9_-]{35}"
  # Telegram bot token: the bot id, a colon, then 35 characters that start with
  # `AA`. Tier 2 never saw it: VALUE stops at the colon, and the 8-10 digits in
  # front are under the floor even behind TELEGRAM_BOT_TOKEN=.
  RE = RE "|[0-9]{8,10}:AA[A-Za-z0-9_-]{33}"
  RE = RE "|(sk|rk)_live_[A-Za-z0-9]{20,}"
  RE = RE "|at-[A-Za-z0-9]{30,}"
  RE = RE "|ATATT[A-Za-z0-9_=.-]{20,}"
  RE = RE "|eyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\."
  RE = RE "|://[^/:@ ]+:[^/:@ ]{3,}@"
  RE = RE "|BEGIN (RSA |EC |OPENSSH |PGP )?PRIVATE KEY"
  # The same header in base64, as kubeconfig carries it in client-key-data:
  # `-----BEGIN ` encodes to LS0tLS1CRUdJTi, and the alternatives are the
  # bare, RSA, EC, DSA, OPENSSH, ENCRYPTED and PGP spellings of
  # `PRIVATE KEY` after it. Certificates encode differently and are left
  # alone. `kubectl config view --raw` printed a key this way (2026-10-09).
  RE = RE "|LS0tLS1CRUdJTiB(QUklWQVRFIEtF|SU0EgUFJJVkFURSBL|FQyBQUklWQVRFIEtF|EU0EgUFJJVkFURSBL|PUEVOU1NIIFBSSVZBVEUgS0VZ|FTkNSWVBURUQgUFJJVkFURSBL|QR1AgUFJJVkFURSBL)[A-Za-z0-9+/=]*"

  # The OpenAI family sits apart because it needs a left boundary, and a
  # boundary cannot go inside RE: scrub() masks whatever the pattern matched,
  # so a leading character in the pattern would be masked with the key.
  #
  # Unanchored, `sk-` matched inside an ordinary value: a model name of the
  # shape `zai-sk-glm-4-6-turbo-preview` came back masked.
  #
  # The boundary has to treat `-` as part of a word, not as a separator. A
  # plain word boundary changes nothing here, because the character before
  # `sk-` in that model name IS a hyphen. What a real key has in front of it is
  # a space, a quote, `=`, `:` or the start of the line — so scrub_bounded()
  # below puts that character back instead of masking it.
  SK = "(^|[^A-Za-z0-9_-])sk-(or-v1-|proj-|ant-)?[A-Za-z0-9-]{20,}"

  # tier 2: what a secret is called, and what one looks like.
  LABEL = "(--?)?(pass|passwd|password|pass-phrase|passphrase|token|secret|"
  LABEL = LABEL "api[-_]?key|apikey|auth[-_]?token|access[-_]?key|"
  # kubeconfig names its private key client-key-data; the value is base64
  # that tier 1 also catches by its header, and the label covers a key whose
  # header is not one of the spellings listed there.
  LABEL = LABEL "client[-_]?secret|client[-_]?key[-_]?data|private[-_]?key|credential|authorization|"
  # SQL says it in two words: CREATE USER … IDENTIFIED BY '…', and the same
  # spelling appears in Oracle, MySQL and MariaDB. `bin/safe-env` has carried
  # this rule since the first commit and this file did not, which is the shape
  # of drift two implementations of one policy produce in silence.
  LABEL = LABEL "identified[[:space:]]+by|"
  # Cloud keys with no distinctive prefix. AWS is covered by tier 1 (AKIA…),
  # Huawei and OpenStack are not: their access key is 20 characters of
  # uppercase and digits, the secret 40 of base62 — shapes that also describe a
  # git SHA and half the identifiers in ordinary output, so tier 1 cannot take
  # them. The variable name is the only reliable signal, and it is right there.
  LABEL = LABEL "hw[-_]?(access|secret)([-_]?key)?|huaweicloud?[-_]?[a-z_]*key|"
  LABEL = LABEL "os[-_](access|secret)[-_]?key)s?"
  # 16 is the floor: an md5 is 32 and a git SHA is 40, so length alone can
  # never decide this — only the label can.
  VALUE = "[A-Za-z0-9+/=_.~-]{16,}"
  # A password is the one string that carries punctuation — `S3cr3t!Pass#2026`
  # stops at the first `!` in the class above, six characters short of the
  # floor, and went through untouched. Inside quotes the writer has already
  # said where the value ends, so the quotes are the boundary. 8 is the floor
  # there: a quoted run is far less ambiguous than a bare one.
  QUOTED = "\"[^\"]{8,}\"|'"'"'[^'"'"']{8,}'"'"'"
  # Below the floor, and unquoted. The floor of 16 was chosen so that the word
  # after "token" in a sentence is not masked, and it held until 2026-09-21,
  # when a 10-character password in a docker-compose comment went through a
  # hook that was installed, wired and working:
  #
  #   # - BasicAuth__Password=<10 characters>
  #
  # A short value is admitted here and then decided by composition, in
  # keep_bare(): lower case, upper case and a digit together is what a
  # generated credential looks like and what prose does not. Measured over 40
  # transcripts of sessions on this machine: zero matches. Measured over the
  # transcript of the leak: the value, twice.
  #
  # No apostrophe may appear anywhere in this program: it is one single-quoted
  # shell string, and a contraction in a comment ends it mid-word.
  SHORT  = "[A-Za-z0-9._~+/-]{8,15}"
  ANYVAL = "(" QUOTED "|" VALUE "|" SHORT ")"
  # A YAML key that names a secret and holds a block instead of a value. Its
  # children carry the credentials under keys that are not labels: see
  # scrub_child() below. Matched against the lower-cased line.
  CONTAINER = "^[ \t]*(-[ \t]+)?[\"\047]?[a-z0-9_.-]*" LABEL "[a-z0-9_.-]*[\"\047]?[ \t]*:[ \t]*(#.*)?\r?$"
  CHILD_KEYED = "^[ \t]*(-[ \t]+)?([^ \t:#\"\047]+|\"[^\"]*\"|\047[^\047]*\047)[ \t]*:[ \t]+"
  CHILD_ITEM  = "^[ \t]*-[ \t]+"
  hits = 0
  inblk = 0
}

# Tier 2 fires on a label followed by any long-enough run of token characters,
# and that description also fits a name. Measured 2026-09-14 over 69 Codex
# transcripts: of 51 flagged lines, about 35 were an identifier in source code,
# a metavar in --help output, a Terraform reference or a Kubernetes object name.
#
# In a report that is noise. In the hook it is worse: reading a file with
# `outputTokens: usage.outputTokens` handed the model `<REDACTED:18>` where the
# name should be, and `--anthropic-api-key ANTHROPIC_API_KEY` lost the metavar
# that says which variable to set.
#
# A credential rarely looks like a name. It does not read as dotted fields, it
# is not one SCREAMING_SNAKE word, and it is not lowercase words joined by
# hyphens. Each rule below is narrow on purpose, and each has a case in
# tests/test_redact.sh asserting a real secret of that shape still goes:
# a Huawei access key is 20 characters of uppercase and digits, which is why
# the metavar rule demands an underscore rather than matching upper case alone.
# The unquoted branch of tier 2. A quoted value is not decided here: the writer
# has already said where it begins and ends, so its floor stays 8 and its
# composition is not examined.
function keep_bare(v) {
  if (is_name(v))       return 1
  if (length(v) >= 16)  return 0      # the old floor, unchanged above it
  # Short and unquoted: mask only what reads as generated. `Tr0ub4dor` is a
  # password by this rule and was deliberately left alone before 0.9.0 -- the
  # gap that cost a real credential. `deploy_v2`, `main-2026` and `utf8mb4` are
  # not, because each is missing one of the three classes.
  return (v ~ /[a-z]/ && v ~ /[A-Z]/ && v ~ /[0-9]/) ? 0 : 1
}

function is_name(v) {
  if (v ~ /^[$]/)                                     return 1   # $VAR, ${VAR}
  if (v ~ /^(var|data|local|module|each|self)\./)     return 1   # Terraform reference
  if (v ~ /^[~.]?\//)                                 return 1   # /path ./path ~/path
  if (v ~ /\./ && v ~ /^[A-Za-z_][A-Za-z_.]*$/)       return 1   # pkg.field.name
  if (v ~ /^[A-Z][A-Z0-9]*(_[A-Z0-9]+)+$/)            return 1   # ANTHROPIC_API_KEY
  if (v ~ /^[a-z]+(-[a-z]+)+$/)                       return 1   # prometheus-operator
  if (v ~ /^[a-z][a-z0-9]*(-[a-z][a-z0-9]*)*-v?[0-9]+([.][0-9]+)+(-[a-z0-9.]+)?$/) return 1   # victoria-metrics-agent-0.30.0
  # A PEM header and nothing after it: documentation that names the shape of a
  # key, quoted after a private_key label, holds no key material. Anything with KEY in
  # it is left to tier 1 and the block rule, and so is every longer value.
  if (v ~ /^-+BEGIN( [A-Z]+)*-*$/ && v !~ /KEY/)       return 1   # -----BEGIN
  if (v ~ /^[a-z]+(_[a-z]+)+$/)                       return 1   # aws_secrets_manager
  # A placeholder in angle brackets, where documentation puts the value:
  # <your-password>, <API_KEY>, <22-char literal>. Quoted after a label it
  # cleared the floor of 8 and was masked -- measured 2026-10-09 on a review
  # report. Inside: words with a space, or one lower-case or one upper-case word
  # joined by - or _. A generated value in brackets has no space and mixes case
  # or digits, so it is still masked.
  if (v ~ /^<([A-Za-z0-9_.:-]* [A-Za-z0-9 _.:-]*|[a-z]+([_-][a-z]+)*|[A-Z]+(_[A-Z]+)*)>$/) return 1   # <your-token>
  return 0
}

# Mask every occurrence of PAT in the current line, counting the hits.
# scrub(), but the pattern carries one leading boundary character that is NOT
# part of the secret. The match is re-emitted with that character in front of
# the mask. `(^|…)` means the group can be empty, so the first character of the
# match is only put back when it is actually the boundary and not the `s` of
# `sk-`.
function scrub_bounded(pat,   out, rest, m, before, head) {
  out = ""; rest = $0
  while (match(rest, pat)) {
    before = substr(rest, 1, RSTART - 1)
    m = substr(rest, RSTART, RLENGTH)
    head = ""
    if (substr(m, 1, 2) != "sk") { head = substr(m, 1, 1); m = substr(m, 2) }
    out = out before head mask(m)
    rest = substr(rest, RSTART + RLENGTH)
    hits++
  }
  $0 = out rest
}

function scrub(pat,   out, rest, m, before) {
  out = ""; rest = $0
  while (match(rest, pat)) {
    before = substr(rest, 1, RSTART - 1)
    m = substr(rest, RSTART, RLENGTH)
    out = out before mask(m)
    rest = substr(rest, RSTART + RLENGTH)
    hits++
  }
  $0 = out rest
}

# Mask only the value that follows a labelled secret, never the label itself:
# `--pass 6310…` must stay readable as `--pass <REDACTED:32>`, otherwise the
# model cannot tell what was removed.
#
# Matching runs against a lower-cased copy of the line, and every offset is then
# applied to the original. The label list is written in lower case, and awk
# matches case-sensitively, so before this `TOKEN: 6310…` and `TOKEN=6310…` came
# through untouched while `token: 6310…` was masked. Uppercase is how a token
# appears in most output there is — an env dump, a config echo, a CI log.
#
# gawk has IGNORECASE and mawk does not, and this file runs under either, so the
# fix cannot be a flag. tolower() preserves length for the ASCII these patterns
# describe, which is what makes the offsets transferable.
# A credential glued to its flag, or sitting after a colon in a user:password
# pair. Tier 2 needs a separator between label and value — a space, an = or a
# colon — and three long-lived client idioms have none:
#
#     mysql -uroot -pSup3rSecret -h db        the form the MySQL client documents
#     redis-cli -a Sup3rSecret ping           every Redis tutorial
#     smbclient //srv/s -U admin%Sup3rSecret
#     curl -u admin:Sup3rSecret https://x     and the --user spelling
#
# Each is gated on the command that owns the idiom, because -p, -a and -u mean
# other things elsewhere: ls -p, grep -a, sort -u. The label stays readable and
# only the value is replaced, exactly as in tier 2.
function scrub_tail(pat, tailpat,   out, rest, lrest, m, mstart, mlen, tail, tstart, tlen) {
  out = ""; rest = $0; lrest = tolower($0)
  while (match(lrest, pat)) {
    mstart = RSTART; mlen = RLENGTH
    m = substr(rest, mstart, mlen)
    if (match(substr(lrest, mstart, mlen), tailpat) == 0) {
      out = out substr(rest, 1, mstart + mlen - 1)
      rest = substr(rest, mstart + mlen); lrest = substr(lrest, mstart + mlen)
      continue
    }
    tstart = RSTART; tlen = RLENGTH
    tail = substr(m, tstart, tlen)
    if (is_mask(tail)) {
      out = out substr(rest, 1, mstart + mlen - 1)
      rest = substr(rest, mstart + mlen); lrest = substr(lrest, mstart + mlen)
      continue
    }
    out = out substr(rest, 1, mstart - 1) substr(m, 1, tstart - 1) mask(tail)
    rest = substr(rest, mstart + mlen); lrest = substr(lrest, mstart + mlen)
    hits++
  }
  $0 = out rest
}

function scrub_labelled(sep,   pat, out, rest, lrest, m, head, val, mstart, mlen, vstart, q, sch, keep) {
  pat = LABEL sep ANYVAL
  out = ""; rest = $0; lrest = tolower($0)
  while (match(lrest, pat)) {
    # Keep the outer match position before matching again inside it: the second
    # match overwrites RSTART, and re-finding the text with index() can land on
    # an earlier occurrence the outer pattern spanned differently.
    mstart = RSTART; mlen = RLENGTH
    m = substr(rest, mstart, mlen)
    # The head is the label and its separator, anchored at the front — not
    # "whatever is left once VALUE has taken the longest suffix it can". VALUE
    # admits `=` and `_`, so on `password=6310…` that reading matched the whole
    # string from the first character and masked the label with the value:
    # `<REDACTED:41>` instead of `password=<REDACTED:32>`. `--pass 6310…`
    # escaped it only because a space is not in VALUE. Losing the label defeats
    # the point of tier 2 — the model is supposed to see what was removed.
    if (match(tolower(m), "^" LABEL sep) == 0) break
    vstart = RLENGTH + 1
    head = substr(m, 1, vstart - 1)
    val = substr(m, vstart)
    # A bare word and a space is how prose and test reports use these words:
    # `ok  pass  NAME=off`, `expect pass "case name"`, "the password field".
    # Measured 2026-10-01: a test suite printing pass/fail per case came back
    # with every case name masked. A space alone separates a value only after a
    # flag (`--pass X`, `-token X`) or in SQL (`IDENTIFIED BY`); a bare label
    # needs `=` or `:`. Only the label is consumed, so a labelled value later
    # on the same line is still found.
    if (head !~ /[=:]/ && head !~ /^-/ && tolower(head) !~ /^identified/) {
      out = out substr(rest, 1, mstart + vstart - 2)
      rest  = substr(rest,  mstart + vstart - 1)
      lrest = substr(lrest, mstart + vstart - 1)
      continue
    }
    # A quoted value keeps its quotes: they belong to the line, not to the
    # secret, and `password="<REDACTED:20>"` still reads as a quoted field.
    q = substr(val, 1, 1)
    if ((q == "\"" || q == "'"'"'") && substr(val, length(val), 1) == q) {
      val = substr(val, 2, length(val) - 2)
      head = head q
      # JSON puts the scheme inside the quotes: {"Authorization": "Bearer …"}.
      # The scheme stays readable, as it does unquoted, and what follows it
      # clears the quoted floor of 8 on its own. Measured 2026-10-08: the
      # placeholder "Bearer ..." in public Opencode docs came back masked whole.
      sch = 0
      if (match(tolower(val), /^(bearer|basic|token)[[:space:]]+/)) {
        head = head substr(val, 1, RLENGTH); val = substr(val, RLENGTH + 1); sch = 1
      }
      keep = is_name(val) || is_mask(val) || (sch && length(val) < 8)
      out = out substr(rest, 1, mstart - 1) head (keep ? val : mask(val)) q
      if (!keep) hits++
    } else if (keep_bare(val)) {
      out = out substr(rest, 1, mstart - 1) head val
    } else {
      out = out substr(rest, 1, mstart - 1) head mask(val)
      hits++
    }
    rest  = substr(rest,  mstart + mlen)
    lrest = substr(lrest, mstart + mlen)
  }
  $0 = out rest
}

# A credential block in YAML puts the label on the parent line and the values
# under it, keyed by something that is not a label at all -- a user name:
#
#     userpass:
#       bosh: <32 characters>
#
# Tier 2 reads `bosh:` and sees nothing that names a secret. Measured
# 2026-10-05: a Hysteria2 config.yaml printed over ssh put three passwords into
# a transcript through a hook that was installed, wired and working.
#
# The parent line sets the indent. Every deeper line is a child, a blank line
# keeps the block open, and the first line at the parent indent or shallower
# ends it. A child value is decided by the tier 2 rules -- a quoted run of 8 or
# more that is not a name, a bare one that keep_bare() would mask -- so
# `min_length: 12` under `password:` stays readable. A URL stays too: one with
# credentials in it is tier 1, and the rest is an endpoint, not a secret.
# A line that is one credential-shaped token and nothing else is masked by its
# shape alone, with no label anywhere: a file of passwords for different
# services kept one per line, `cut -d= -f1` over such a file, `cat -n` and
# `grep -n` of it. 2026-10-08 a password printed that way reached the
# transcript through Read, an @ attachment and cut, because every rule above
# wanted a label.
#
# The shape: 8 to 128 characters, no space, a lower-case letter, an upper-case
# letter and a digit, and only characters a password is made of -- letters,
# digits and !@#$%^&*()_+=?~.,;:- . What a line of ordinary output looks like
# is left alone: a flag (leading -), a path or URL, a hex hash, a number, a
# date or an address, an assignment NAME=, a heading ending in :, a file name
# with its extension (grep -n and grep -A print FILE.md:12 and FILE.md-12-),
# a manual reference ls(1), and the name shapes of is_name(). Measured
# 2026-10-08 over 396637 lines of tool output on this machine: about 60 lines,
# most of them random tokens. A CamelCase identifier with a digit alone on its
# line is masked too: by shape it cannot be told from a password made of two
# words and a year. Not caught: a password without one of the three classes,
# such as only lower-case letters and digits -- that shape is every hash, id
# and generated name in ordinary output.
function scrub_bare(   head, v, tail) {
  match($0, /^[ \t]*([0-9]+[\t:][ \t]*)?/)
  head = substr($0, 1, RLENGTH); v = substr($0, RLENGTH + 1)
  tail = ""
  if (match(v, /[ \t\r]+$/)) { tail = substr(v, RSTART); v = substr(v, 1, RSTART - 1) }
  if (length(v) < 8 || length(v) > 128) return
  if (v !~ /^[A-Za-z0-9!@#$%^&*()_+=?~.,;:-]+$/) return
  if (v !~ /[a-z]/ || v !~ /[A-Z]/ || v !~ /[0-9]/) return
  if (v ~ /^[-#~.]/ || v ~ /^[0-9a-f]+$/ || v ~ /^[0-9.:,-]+$/) return
  if (v ~ /^[A-Za-z_][A-Za-z0-9_.-]*=/ || v ~ /:$/ || v ~ /[(][0-9]+[)]$/) return
  if (v ~ /[.][A-Za-z][A-Za-z0-9]?[A-Za-z0-9]?[A-Za-z0-9]?[A-Za-z0-9]?[A-Za-z0-9]?([-:][0-9]+)*[-:]?$/) return
  if (v ~ /[.][A-Za-z][A-Za-z0-9]*[.][0-9]+([-_][0-9]+)*$/) return   # SKILL.md.bak.20261001-191831
  if (is_name(v) || is_mask(v)) return
  $0 = head mask(v) tail
  hits++
}

function scrub_child(   head, rest, q, val, tail) {
  if (!match($0, CHILD_KEYED) && !match($0, CHILD_ITEM)) return
  head = substr($0, 1, RLENGTH); rest = substr($0, RLENGTH + 1)
  q = substr(rest, 1, 1)
  if (q == "\"" || q == "\047") {
    if (!match(rest, "^" q "[^" q "]*" q)) return
    val = substr(rest, 2, RLENGTH - 2); tail = substr(rest, RLENGTH + 1)
    if (length(val) < 8 || is_name(val) || is_mask(val)) return
    $0 = head q mask(val) q tail
  } else {
    if (!match(rest, /^[^ \t\r]+/)) return
    val = substr(rest, 1, RLENGTH); tail = substr(rest, RLENGTH + 1)
    if (length(val) < 8 || is_mask(val) || index(val, "://") > 0 || keep_bare(val)) return
    $0 = head mask(val) tail
  }
  hits++
}

# A private key is a block, and awk sees lines. Tier 1 matches the BEGIN text
# and nothing else, so the result came back with `-----<REDACTED:25>-----` on
# top and the key itself intact underneath — which reads as handled and is not.
#
# The header sets the flag, the footer clears it, and the body is replaced line
# for line so that a diff of the result against the file still lines up. Both
# markers are anchored to a line of their own: the phrase inside a sentence
# must not start swallowing a document.
/^-+BEGIN [A-Z0-9 ]*PRIVATE KEY-+$/ { inkey = 1 }
/^-+END [A-Z0-9 ]*PRIVATE KEY-+$/   { inkey = 0 }
inkey && !/PRIVATE KEY/ { print mask($0); hits++; next }

{
  scrub(RE)
  scrub_bounded(SK)
  # Gated on the client name so the flag letters keep their other meanings.
  if (tolower($0) ~ /(^|[[:space:]])(mysql|mariadb|mysqldump|mysqladmin)([[:space:]]|$)/)
    # The tail starts after the -p, so the class excludes the dash and the p
    # itself. A password beginning with either keeps its first character
    # visible, which is the cheap end of the trade: the alternative masks
    # the flag and the model can no longer see what was removed.
    scrub_tail("(^|[[:space:]])-p[^[:space:]]{8,}", "[^-p[:space:]][^[:space:]]{7,}$")
  if (tolower($0) ~ /(^|[[:space:]])redis-cli([[:space:]]|$)/)
    scrub_tail("(^|[[:space:]])-a[[:space:]]+[^[:space:]]{8,}", "[^[:space:]]{8,}$")
  if (tolower($0) ~ /(^|[[:space:]])smbclient([[:space:]]|$)/)
    scrub_tail("(^|[[:space:]])-u[[:space:]]*[a-z0-9_.@-]+%[^[:space:]]{8,}", "[^%[:space:]]{8,}$")
  if (tolower($0) ~ /(^|[[:space:]])(curl|wget|http)([[:space:]]|$)/ || index(tolower($0), "--user ") > 0)
    scrub_tail("(^|[[:space:]])(-u|--user)[[:space:]]+[a-z0-9_.@-]+:[^[:space:]]{8,}", "[^:[:space:]]{8,}$")
  # Both spellings in one pattern — `password=X`, `TOKEN: X`, `--pass X` — and
  # deliberately not two calls. LABEL sep VALUE is a *dynamic* regular
  # expression: gawk compiles it where it is used and caches the compiled form,
  # so two different `sep` values alternating per line miss that cache and
  # recompile the whole LABEL alternation twice for every line of input.
  # Measured 2026-09-16 on a 1.1 MB payload: 10.50 s for the two calls, 0.34 s
  # for the same call twice, 0.27 s like this. The hook is killed at its
  # timeout, and a killed hook replaces nothing, so this was the difference
  # between masking a large result and handing it over whole.
  # `"?` in front: the JSON spelling puts a closing quote between the label and
  # the colon — {"password": "…"} — and neither separator admitted it.
  # `(bearer|basic|token) ` after: an HTTP header puts the scheme between the
  # label and the value, and the scheme stays readable for the same reason the
  # label does.
  scrub_labelled("\"?([[:space:]]*[=:][[:space:]]*|[[:space:]]+)((bearer|basic|token)[[:space:]]+)?")
  scrub_bare()
  # After the line rules, so a child they already masked is seen as a mask.
  if (inblk) {
    if ($0 ~ /^[ \t\r]*$/) { }
    else if (index($0, blkind) == 1 && substr($0, length(blkind) + 1, 1) ~ /[ \t]/) scrub_child()
    else inblk = 0
  }
  if (!inblk && tolower($0) ~ CONTAINER) {
    match($0, /^[ \t]*/); blkind = substr($0, 1, RLENGTH); inblk = 1
  }
  print
}
END { exit (hits > 0 ? 0 : 1) }
'

# Where the scratch files go, and what clears them when this process does not.
#
# A SIGKILL runs no trap, and the harness kills this hook exactly when it is
# slow — so a killed run used to leave its whole payload in /tmp for good:
# 74 MB from one kill, with the tool result inside it. One known parent, one
# sweep by age at start-up, and the run directory itself is 0700 whatever the
# umask says, because what is in it is the output of somebody's shell.
#
# The parent must belong to this user. In a shared /tmp anyone can create
# /tmp/secrets-redact first, and `chmod 700` on a directory someone else owns
# fails — that failure used to be ignored, so every run directory, payload
# included, was made inside a directory its owner could read and rename things
# in. A parent that is a symlink or not ours is never used: the run gets a fresh
# directory of its own beside it, which the age sweep does not cover, and that
# is the price of not trusting the shared name. With no TMPDIR set, the
# per-user XDG_RUNTIME_DIR comes before /tmp when it is ours.
scratch_dir () {
    root="${TMPDIR:-}"
    if [ -z "$root" ]; then
        root=/tmp
        if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ] &&
           [ ! -L "$XDG_RUNTIME_DIR" ] && [ -O "$XDG_RUNTIME_DIR" ]; then
            root="$XDG_RUNTIME_DIR"
        fi
    fi
    base="$root/secrets-redact"
    (umask 077; mkdir -p "$base") 2>/dev/null
    if [ -L "$base" ] || [ ! -d "$base" ] || [ ! -O "$base" ]; then
        mktemp -d "$root/secrets-redact.XXXXXX" 2>/dev/null
        return
    fi
    chmod 700 "$base" 2>/dev/null || true
    # Only this tool's own run directories, and only ones old enough that no
    # live run could own them.
    find "$base" -maxdepth 1 -mindepth 1 -type d -name 'run.*' -mmin +60 \
         -exec rm -rf {} + 2>/dev/null || true
    mktemp -d "$base/run.XXXXXX" 2>/dev/null
}

redact () { "$AWK" "$REDACT_AWK"; rrc=$?; note_run "$rrc"; return $rrc; }

# ── the journal ─────────────────────────────────────────────────────────────
# One line per invocation, no values, ever. It exists because of 2026-09-21: a
# password reached a transcript, and from the outside "the hook was never
# called", "it was called and matched nothing" and "it was called, matched, and
# the host ignored the replacement" are the same observation — nothing. Half a
# day went into an investigation that this line would have ended in a second.
#
# What is recorded: when, which mode, which tool, how many bytes came in,
# whether anything was replaced. A count of hits is safe; a hit itself is not,
# so no fragment of the input is ever written here.
#
# Failure is silent and never blocks masking: a hook that dies because a log
# directory is read-only is worse than no log. Capped by size rather than by
# date, since a session can produce thousands of calls in an hour.
REDACT_LOG="${ENV2HELL_LOG:-${XDG_STATE_HOME:-$HOME/.local/state}/env2hell/redact.log}"
REDACT_LOG_MAX="${ENV2HELL_LOG_MAX:-1048576}"
# One invocation can run the masking pass more than once -- hook mode does
# stdout and stderr separately -- and that must stay ONE line, or a reader
# counting entries counts passes instead of calls. So the passes accumulate and
# `flush_log` writes the line at exit.
note_run () {   # $1 exit code of the awk pass: 0 something was masked, 1 nothing
    [ "$1" = 0 ] && LOG_ANY=yes
    LOG_PASSES=$(( ${LOG_PASSES:-0} + 1 ))
    return 0
}
flush_log () {
    [ "${LOG_PASSES:-0}" -gt 0 ] || return 0
    [ "${ENV2HELL_LOG:-x}" = "off" ] && return 0
    mkdir -p "$(dirname "$REDACT_LOG")" 2>/dev/null || return 0
    if [ -f "$REDACT_LOG" ]; then
        size=$(wc -c < "$REDACT_LOG" 2>/dev/null || echo 0)
        [ "${size:-0}" -gt "$REDACT_LOG_MAX" ] && mv -f "$REDACT_LOG" "$REDACT_LOG.1" 2>/dev/null
    fi
    printf '%s mode=%s tool=%s bytes=%s masked=%s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${LOG_MODE:-filter}" "${LOG_TOOL:--}" \
        "${LOG_BYTES:--}" "${LOG_ANY:-no}" \
        >> "$REDACT_LOG" 2>/dev/null || return 0
    LOG_PASSES=0
}

# awk's `print` terminates every line, so a stream that did not end in a
# newline comes back one byte longer. Take that byte off again.
# `wc -l` counts newlines, so a one-byte tail reports 1 exactly when that byte
# is the newline.
ends_nl () { [ -s "$1" ] && [ "$(tail -c1 "$1" | wc -l)" -eq 1 ]; }
untrail () {   # $1 masked file, $2 the file it was made from
    if [ -s "$1" ] && ! ends_nl "$2"; then
        printf '%s' "$(cat "$1")" > "$1.trim" && mv "$1.trim" "$1"
    fi
}

if [ "${1:-}" = "--self-test" ]; then
    printf '%s\n' \
        'croc --relay h:9009 --pass deadbeefdeadbeefdeadbeefdeadbeef code-word' \
        'md5sum: deadbeefdeadbeefdeadbeefdeadbeef  big.bin' \
        'export GH=ghp_0123456789abcdefghijklmnopqrstuvwxyzAB' | redact
    exit 0
fi

# Plain text in, masked text out, no JSON either side. This is what the Opencode
# plugin calls: its hook hands over the tool output as a string and expects a
# string back, so wrapping it in the Claude Code payload shape only to unwrap it
# again would be ceremony. Needs no jq, which also makes it the mode to reach
# for by hand, in a pipe.
#
# Exit 0 means something was masked, 1 means the text came through unchanged —
# so a caller can skip the assignment rather than rewrite a string with itself.
if [ "${1:-}" = "--filter" ]; then
    # The hook path has repaired awk's added newline since it was written; this
    # mode never did, so a plugin that replaces a tool result with the masked
    # version added a byte to it. Buffering is what makes the repair possible —
    # whether the input ended in a newline is only knowable once it has ended —
    # and it fails open: no temp file, mask straight through as before.
    ftmp="$(scratch_dir)" || { redact; exit $?; }
    [ -n "$ftmp" ] || { redact; exit $?; }
    trap 'rm -rf "$ftmp"; flush_log' EXIT
    cat > "$ftmp/in" || { redact < /dev/null; exit $?; }
    LOG_BYTES="$(wc -c < "$ftmp/in" 2>/dev/null || echo -)"
    redact < "$ftmp/in" > "$ftmp/out"; frc=$?
    untrail "$ftmp/out" "$ftmp/in"
    cat "$ftmp/out"
    exit $frc
fi

# ── hook mode ───────────────────────────────────────────────────────────────
command -v jq >/dev/null 2>&1 || exit 0     # fail open, never break the CLI

# The payload is written to a file once and never held in a shell variable or
# passed as an argument. Both of those have limits this hook used to hit in
# silence:
#
#   `jq --arg out "$big"` dies with "Argument list too long" at MAX_ARG_STRLEN,
#   which is 128 KB on Linux and has nothing to do with ARG_MAX as a whole. The
#   `|| exit 0` after it then failed open. Measured 2026-09-14: output of 96 KB
#   was masked, output of 128 KB went to the model with the token intact — and
#   nothing anywhere said so.
#
# So: `--rawfile` instead of `--arg`, files instead of `$(...)`, and jq reads
# the payload from disk each time rather than from a copy in the environment.
# Command substitution also strips trailing newlines, so a stream captured that
# way could no longer be compared with what came back — this hook redacts, it
# does not reformat, and `--rawfile` is byte-exact where `$(cat)` is not.
tmp="$(scratch_dir)" || exit 0
[ -n "$tmp" ] || exit 0
trap 'rm -rf "$tmp"; flush_log' EXIT

cat > "$tmp/payload" || exit 0
[ -s "$tmp/payload" ] || exit 0

# Named for the journal before anything can bail out. Which tool produced the
# result is the field that makes a missing line legible: "no entry for that
# Bash call" and "an entry saying nothing matched" are different diagnoses.
LOG_MODE="hook"
[ "${1:-}" = "--warn-only" ] && LOG_MODE="warn"
LOG_BYTES="$(wc -c < "$tmp/payload" 2>/dev/null || echo -)"
LOG_TOOL="$(jq -r 'try (.tool_name // "-")' < "$tmp/payload" 2>/dev/null || echo -)"

# ── warn-only mode, where a result cannot be replaced ───────────────────────
# Two events land here, and neither can be rewritten.
#
# Codex's PostToolUseOutcome carries should_block, additional_contexts and
# feedback_message, and nothing that replaces output.
#
# Claude Code's `PostToolUseFailure` is the same shape of problem and the more
# expensive one. A command that exits non-zero does not fire `PostToolUse` at
# all; it fires this event instead, whose only documented return field is
# `additionalContext`. So for a failed command there is no masking to be had —
# not because the hook declines, but because the contract has no slot for a
# replacement.
#
# That is the case this whole file was written for. Measured 2026-09-14: a
# `git remote -v` that exited 1 because a later command in the same call failed
# put a GitLab token into the transcript in full. A failing command is exactly
# when a credential surfaces — a URL carrying a password, an auth error quoting
# the key — and it is the one path where the value cannot be taken back.
#
# What is left is to say so. The model learns that a credential is now in the
# transcript, which is what turns a silent leak into a rotation. The message
# never repeats the value and never says which command produced it: both would
# put a second copy in the very transcript being warned about.
if [ "${1:-}" = "--warn-only" ]; then
    # Claude Code puts a failed command's output in a top-level `error` string —
    # first line `Exit code N`, then stdout and stderr interleaved as one block.
    # Codex names the shell result `output`; a successful Claude Code call
    # splits it into stdout and stderr. Read every shape: detection costs
    # nothing and a field that does not exist contributes nothing.
    # Every string anywhere in the result, plus the failure event's top-level
    # `error`. Detection can afford recursive descent where replacement cannot:
    # nothing is rebuilt here, so an unfamiliar schema costs a false positive at
    # worst, never a mangled result.
    #
    # That asymmetry is why this mode exists for `Edit`, `Write` and the MCP
    # tools. An Edit result carries the file in four places — `originalFile`,
    # `oldString`, `newString` and `structuredPatch[].lines` — and an MCP result
    # is an array of content blocks. Masking one field of those and not the rest
    # would read as coverage while leaving the same secret in the next field
    # along. Saying "a credential is in this result" is the honest service.
    #
    # `originalFile` is read too. It used to be dropped on the claim that the
    # transcript stores it empty beside `contentNotInModelContext`. Measured on
    # a Claude Code 2.1.294 transcript (toolUseResult records with an
    # originalFile key): a Write over an existing file keeps the old file in
    # full in 5 of 8 records (the other 3 overwrote an empty file); an Edit
    # keeps it in full in 85 of 138, and 59 of those 85 carry
    # `contentNotInModelContext: true` all the same. So the flag does not mean
    # "stored empty" and cannot gate the scan. Whether the live hook payload
    # carries the flag at all is not known from this repository: no fixture
    # has it. Either way the safe side is to scan, because a credential in
    # that field sits in the transcript on disk.
    jq -j 'try ([ (.error? | select(type == "string")),
                  (.tool_response?
                   | .. | strings) ]
                | join("\n"))' \
       < "$tmp/payload" > "$tmp/warn" 2>/dev/null
    [ -s "$tmp/warn" ] || exit 0

    # Where the text came from decides what the warning may say. The fields
    # that carry the file as it was before the call — `originalFile`, and the
    # `structuredPatch` hunks with their "-" and context lines — reach the
    # transcript on disk but not the model: it wrote or read none of that text
    # in this call. Everything else is the model's own call or its output. A
    # hit only in the first group is "rotate if real", not "you printed it".
    jq -j 'try ([ (.error? | select(type == "string")),
                  (.tool_response?
                   | if type == "object" then del(.originalFile, .structuredPatch) else . end
                   | .. | strings) ]
                | join("\n"))' \
       < "$tmp/payload" > "$tmp/warn_fresh" 2>/dev/null

    # `grep -c` counts matching *lines*, so four values on two lines were
    # reported as two — and always downwards, in the one message a human reads
    # to decide whether to rotate. Count the masks themselves.
    hits="$(redact < "$tmp/warn" | grep -o '<REDACTED:' | wc -l || true)"
    [ "${hits:-0}" -gt 0 ] || exit 0
    fresh=0
    if [ -s "$tmp/warn_fresh" ]; then
        fresh="$(redact < "$tmp/warn_fresh" | grep -o '<REDACTED:' | wc -l || true)"
    fi

    # The event has to be named back exactly as it arrived. A hook wired to
    # PostToolUseFailure that answers "PostToolUse" is answering a question
    # nobody asked, and the reply is dropped.
    jq -c --argjson n "$hits" --argjson fresh "${fresh:-0}" '
      {
        hookSpecificOutput: {
          hookEventName: (.hook_event_name // "PostToolUse"),
          additionalContext: (
            if $fresh > 0 then
              "[secrets-redact] This output contains \($n) credential-shaped value(s). " +
              "It cannot be removed here, so it is already in the transcript. Do not " +
              "repeat it, do not echo the command that produced it, and tell the user " +
              "the value has to be rotated."
            else
              "[secrets-redact] \($n) credential-shaped value(s) found in the previous " +
              "content of the file, which Claude Code keeps in the transcript on disk; " +
              "the model context did not receive it. Do not repeat it. Rotate it if it " +
              "is a real credential."
            end
          )
        }
      }' < "$tmp/payload" 2>/dev/null || exit 0
    exit 0
fi

# A result reaches this hook in one of four shapes, and they are not
# interchangeable — replacing an output with the wrong schema is worse than not
# replacing it:
#
#   streams   {"stdout": …, "stderr": …}      a shell call that succeeded
#   file      {"file": {"content": …}, …}     what the Read tool returns
#   content   {"content": "…"}                one blob; Grep returns this
#   string    "…"                             a result handed over whole
#
# The string branch is defensive, not a path any assistant here is known to
# take. It was added on 2026-09-14 on the reading that a failed `git remote -v`
# arrived this way, because that is how the transcript *stores* a failed
# result. It is not how the hook is *called*: Claude Code routes a non-zero
# exit to PostToolUseFailure, where `error` is a top-level string and nothing
# can replace it — see the --warn-only branch. Opencode never reaches JSON mode
# at all; its plugin calls --filter. Kept because it costs one comparison and
# fails closed on a shape nobody has ruled out.
#
# Detect the shape first, then rebuild in that same shape.
shape="$(jq -r '
    (.tool_response // empty) as $r
    | if   ($r | type) == "string"               then "string"
      elif ($r | type) != "object"               then "other"
      elif ($r.stdout? | type) == "string"
        or ($r.stderr? | type) == "string"       then "streams"
      elif ($r.file?.content? | type) == "string" then "file"
      elif ($r.content? | type) == "string"      then "content"
      else "other"
      end' < "$tmp/payload" 2>/dev/null)"

CTX="[secrets-redact] A secret-shaped value in this output was replaced with <REDACTED:length>. Do not try to recover it, and do not print the command that produced it."

# ── one blob: a bare string, {"content": …}, or Read's {"file":{"content"…}} ─
if [ "$shape" = "string" ] || [ "$shape" = "content" ] || [ "$shape" = "file" ]; then
    jq -j --arg s "$shape" '
        try (if   $s == "string" then .tool_response
             elif $s == "file"   then .tool_response.file.content
             else .tool_response.content end) // empty' \
        < "$tmp/payload" > "$tmp/in.one" 2>/dev/null
    [ -s "$tmp/in.one" ] || exit 0

    redact < "$tmp/in.one" > "$tmp/one"; hit_one=$?
    [ "$hit_one" -eq 0 ] || exit 0                       # nothing matched
    untrail "$tmp/one" "$tmp/in.one"

    # --rawfile, not --arg: see the note above mktemp. A Read of a large file is
    # the ordinary case here, not the exotic one, so the 128 KB argument limit
    # would be hit on the first real secret this branch was written for.
    jq -c --rawfile one "$tmp/one" --arg s "$shape" --arg ctx "$CTX" '
        {
          hookSpecificOutput: {
            hookEventName: "PostToolUse",
            updatedToolOutput: (
              if   $s == "string" then $one
              elif $s == "file"   then ((.tool_response // {})
                                        + {file: ((.tool_response.file // {})
                                                  + {content: $one})})
              else ((.tool_response // {}) + {content: $one}) end),
            additionalContext: $ctx
          }
        }' < "$tmp/payload" 2>/dev/null || exit 0
    exit 0
fi

[ "$shape" = "streams" ] || exit 0

# ── the two streams a shell produces ────────────────────────────────────────
jq -j 'try (.tool_response.stdout // empty)' < "$tmp/payload" > "$tmp/in.out" 2>/dev/null
jq -j 'try (.tool_response.stderr // empty)' < "$tmp/payload" > "$tmp/in.err" 2>/dev/null
[ -s "$tmp/in.out" ] || [ -s "$tmp/in.err" ] || exit 0

redact < "$tmp/in.out" > "$tmp/out"; hit_out=$?
redact < "$tmp/in.err" > "$tmp/err"; hit_err=$?
[ "$hit_out" -eq 0 ] || [ "$hit_err" -eq 0 ] || exit 0   # nothing matched

untrail "$tmp/out" "$tmp/in.out"
untrail "$tmp/err" "$tmp/in.err"

# Rebuild from the original tool_response so fields this hook knows nothing
# about (interrupted, isImage, and whatever is added later) survive intact.
jq -c --rawfile out "$tmp/out" --rawfile err "$tmp/err" --arg ctx "$CTX" '
    {
      hookSpecificOutput: {
        hookEventName: "PostToolUse",
        updatedToolOutput: ((.tool_response // {}) + {stdout: $out, stderr: $err}),
        additionalContext: $ctx
      }
    }' < "$tmp/payload" 2>/dev/null || exit 0
